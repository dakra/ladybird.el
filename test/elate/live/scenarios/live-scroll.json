{
  "name": "live-scroll",
  "comment": "Scrolling with the page's own keys, the commands of command mode and the wheel: the page reports where it is, and the colours of its bands arrive on the canvas.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"scroll.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"scroll\")", "timeout": 60},

    {"group": "page-keys", "comment": "with no field focused the page scrolls itself on the cursor keys, SPC, the page keys, the Emacs motion keys and the ends"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#ff0000\")"},
    {"assert": {"eval": "(= (ladybird-live-number \"scrollY\") 0)"}},
    {"keys": "<down>"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"scrollY\") 0)"},
    {"eval": "(progn (sleep-for 0.6) t)", "comment": "the page scrolls smoothly; its step is read once it has stopped"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-number \"scrollY\"))"},
    {"keys": "C-n"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (* 2 ladybird-live-scratch))", "comment": "C-n is <down>"},
    {"keys": "C-p <up>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "SPC"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"scrollY\") (* 2 ladybird-live-scratch))"},
    {"eval": "(progn (sleep-for 0.6) t)"},
    {"eval": "(setq ladybird-live-saved (ladybird-live-number \"scrollY\"))"},
    {"keys": "S-SPC"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "C-v"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") ladybird-live-saved)", "comment": "C-v pages down as SPC does"},
    {"keys": "M-v"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "<next>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") ladybird-live-saved)"},
    {"keys": "<prior>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "M->"},
    {"wait": "until", "pred": "(and (> (ladybird-live-number \"scrollY\") 0) (= (ladybird-live-number \"scrollY\") (ladybird-live-number \"maxY\")))"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 400) \"#ffffff\")", "comment": "the last band is on the canvas"},
    {"keys": "M-<"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#ff0000\")"},
    {"keys": "<end>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (ladybird-live-number \"maxY\"))"},
    {"keys": "<home>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (ladybird-live-number \"maxY\"))", "comment": "C-e is End"},
    {"keys": "C-a"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "C-k"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (ladybird-live-number \"maxY\"))", "comment": "C-k is Shift+End, which goes to the bottom"},
    {"keys": "M-<"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "C-f"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"scrollX\") 0)"},
    {"keys": "C-b"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollX\") 0)"},

    {"group": "command-keys", "comment": "in command mode n, p, SPC and DEL scroll by lines and pages, > and < go to the ends"},
    {"keys": "C-c C-e"},
    {"keys": "n"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (* 3 (frame-char-height)))"},
    {"keys": "p"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "SPC"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") (- (window-body-height (get-buffer-window (ladybird-live-buffer)) t) (frame-char-height)))"},
    {"keys": "DEL"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "SPC"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "<backspace>", "comment": "the Backspace key of a graphical frame is DEL here"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "<right>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollX\") (* 3 (frame-char-height)))"},
    {"keys": "<left>"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollX\") 0)"},
    {"keys": ">"},
    {"wait": "until", "pred": "(and (> (ladybird-live-number \"scrollY\") 0) (= (ladybird-live-number \"scrollY\") (ladybird-live-number \"maxY\")))"},
    {"keys": "<"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"keys": "<return>", "comment": "the Return key of a graphical frame is RET here"},
    {"assert": {"eval": "(ladybird-live-in-page (not ladybird-command-mode))"}},

    {"group": "wheel", "comment": "the wheel scrolls by its pixels"},
    {"eval": "(ladybird-live-wheel 100 100 520)"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 520)"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#00ff00\")", "comment": "the second band is on the canvas"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 300) \"#00ff00\")"},
    {"eval": "(ladybird-live-wheel 100 100 1000)"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 1520)"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#ffff00\")"},
    {"eval": "(ladybird-live-wheel 100 100 -1520)"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"scrollY\") 0)"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#ff0000\")"},
    {"mouse": "wheel", "x": 100, "y": 100, "direction": "down", "count": 1, "comment": "a wheel notch scrolls by lines"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"scrollY\") 0)"},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
