{
  "name": "live-navigation",
  "comment": "Moving between pages: a clicked link, C-c C-l with a URL, back and forward with their limits, reload with and without the cache, zoom, and stopping a page that is slow to arrive.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"index.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"index\")", "timeout": 60},

    {"group": "link", "comment": "a click on a link loads its page"},
    {"assert": {"eval": "(not (ladybird-live-state (quote can_go_back)))"}},
    {"eval": "(setq ladybird-live-scratch (condition-case err (ladybird-live-in-page (ladybird-back)) (user-error (cadr err))))"},
    {"assert": {"eval": "(equal ladybird-live-scratch \"No page to go back to\")"}, "comment": "b with nothing to go back to is an error"},
    {"mouse": "click", "x": 100, "y": 240, "button": 1},
    {"wait": "until", "pred": "(ladybird-live-page-p \"second\")"},
    {"assert": {"eval": "(equal (ladybird-live-state (quote url)) (ladybird-live-url \"second.html\"))"}},
    {"wait": "until", "pred": "(equal (ladybird-live-color 300 100) \"#00ffff\")", "comment": "the new page is painted"},
    {"assert": {"eval": "(ladybird-live-state (quote can_go_back))"}},

    {"group": "history", "comment": "C-c C-b and C-c C-f move through the history"},
    {"keys": "C-c C-b"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"index\")"},
    {"wait": "until", "pred": "(ladybird-live-state (quote can_go_forward))"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 50 50) \"#ff0000\")"},
    {"keys": "C-c C-f"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"second\")"},
    {"assert": {"eval": "(not (ladybird-live-state (quote can_go_forward)))"}},

    {"group": "reload", "comment": "C-c C-r loads the page again, with C-u bypassing the cache"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-number \"loads\"))"},
    {"keys": "C-c C-r"},
    {"wait": "until", "pred": "(eql (ladybird-live-number \"loads\") (+ ladybird-live-scratch 1))"},
    {"keys": "C-u C-c C-r"},
    {"wait": "until", "pred": "(eql (ladybird-live-number \"loads\") (+ ladybird-live-scratch 2))"},

    {"group": "goto", "comment": "C-c C-l reads a URL and loads it"},
    {"keys": "C-c C-l", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-contents) (ladybird-live-url \"second.html\"))"}, "comment": "the prompt starts with the current URL"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"eval": "(with-selected-window (active-minibuffer-window) (insert (ladybird-live-url \"find.html\")))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"find\")"},

    {"group": "zoom", "comment": "C-x C-+, C-x C-- and C-x C-0 change the zoom the page sees, and + - 0 go on after them"},
    {"eval": "(ladybird-live-load \"index.html\")"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"index\")"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-number \"w\"))"},
    {"keys": "C-x C-+"},
    {"wait": "until", "pred": "(> (ladybird-live-state (quote zoom)) 1.0)"},
    {"wait": "until", "pred": "(< (ladybird-live-number \"w\") ladybird-live-scratch)", "comment": "a zoomed page has fewer CSS pixels"},
    {"keys": "C-x C-0"},
    {"wait": "until", "pred": "(= (ladybird-live-state (quote zoom)) 1)"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"w\") ladybird-live-scratch)"},
    {"keys": "C-x C--"},
    {"wait": "until", "pred": "(> (ladybird-live-number \"w\") ladybird-live-scratch)"},
    {"keys": "0", "comment": "right after C-x C-- a 0 alone resets"},
    {"wait": "until", "pred": "(= (ladybird-live-number \"w\") ladybird-live-scratch)"},

    {"group": "stop", "comment": "C-c C-k stops a page that is slow to arrive"},
    {"eval": "(ladybird-live-load \"slow?ms=6000\")"},
    {"wait": "until", "pred": "(ladybird-live-state (quote loading))"},
    {"assert": {"eval": "(ladybird-live-in-page (equal (substring-no-properties (ladybird--mode-line-process)) \":Page:Loading\"))"}},
    {"keys": "C-c C-k"},
    {"wait": "until", "pred": "(not (ladybird-live-state (quote loading)))", "timeout": 4},
    {"assert": {"eval": "(equal (ladybird-live-field \"page\") \"index\")"}, "comment": "the page that was there stays"},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
