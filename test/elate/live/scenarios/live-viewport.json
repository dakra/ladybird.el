{
  "name": "live-viewport",
  "comment": "The page has the size of its window: after a split, after the frame is resized, and not while the minibuffer grows; the page is told when no window shows it and when the frame loses the focus.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"viewport.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"viewport\")", "timeout": 60},

    {"group": "window", "comment": "the page is as large as the window, and follows a split"},
    {"wait": "until", "pred": "(and (eql (ladybird-live-number \"w\") (window-body-width (get-buffer-window (ladybird-live-buffer)) t)) (eql (ladybird-live-number \"h\") (window-body-height (get-buffer-window (ladybird-live-buffer)) t)))"},
    {"wait": "until", "pred": "(equal (ladybird-live-color (- (window-body-width (get-buffer-window (ladybird-live-buffer)) t) 25) (- (window-body-height (get-buffer-window (ladybird-live-buffer)) t) 25)) \"#ff0000\")", "comment": "the block in the page's corner is in the canvas's corner"},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"set_viewport\") 0)"}, "comment": "the view was created at this size"},
    {"keys": "C-x 2"},
    {"wait": "until", "pred": "(eql (ladybird-live-number \"h\") (window-body-height (get-buffer-window (ladybird-live-buffer)) t))"},
    {"wait": "until", "pred": "(ladybird-live-in-page (equal ladybird--canvas-size (cons (window-body-width (get-buffer-window (ladybird-live-buffer)) t) (window-body-height (get-buffer-window (ladybird-live-buffer)) t))))"},
    {"wait": "until", "pred": "(equal (ladybird-live-color (- (window-body-width (get-buffer-window (ladybird-live-buffer)) t) 25) (- (window-body-height (get-buffer-window (ladybird-live-buffer)) t) 25)) \"#ff0000\")"},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"set_viewport\") 1)"}, "comment": "one resize for the split"},
    {"assert": {"eval": "(eql (ladybird-live-number \"resizes\") 1)"}},
    {"keys": "C-x 1"},
    {"wait": "until", "pred": "(eql (ladybird-live-number \"h\") (window-body-height (get-buffer-window (ladybird-live-buffer)) t))"},

    {"group": "frame", "comment": "a resized frame resizes the page"},
    {"resize": "90x30"},
    {"wait": "until", "pred": "(and (eql (ladybird-live-number \"w\") (window-body-width (get-buffer-window (ladybird-live-buffer)) t)) (eql (ladybird-live-number \"h\") (window-body-height (get-buffer-window (ladybird-live-buffer)) t)))"},
    {"wait": "until", "pred": "(equal (ladybird-live-color (- (window-body-width (get-buffer-window (ladybird-live-buffer)) t) 25) (- (window-body-height (get-buffer-window (ladybird-live-buffer)) t) 25)) \"#ff0000\")"},
    {"resize": "100x35"},
    {"wait": "until", "pred": "(and (eql (ladybird-live-number \"w\") (window-body-width (get-buffer-window (ladybird-live-buffer)) t)) (eql (ladybird-live-number \"h\") (window-body-height (get-buffer-window (ladybird-live-buffer)) t)))"},

    {"group": "mini-window", "comment": "a minibuffer that grows does not resize the page"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"eval": "(setq ladybird-live-scratch (list (ladybird-live-sent-count \"set_viewport\") (ladybird-live-number \"resizes\") (ladybird-live-number \"h\")))"},
    {"keys": "l", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(with-selected-window (active-minibuffer-window) (insert (make-string 400 ?x)))"},
    {"eval": "(progn (sleep-for 0.6) t)"},
    {"assert": {"eval": "(> (ladybird--mini-window-excess (selected-frame)) 0)"}, "comment": "the minibuffer has several lines"},
    {"assert": {"eval": "(< (window-body-height (get-buffer-window (ladybird-live-buffer)) t) (nth 2 ladybird-live-scratch))"}, "comment": "which the page's window lost"},
    {"assert": {"eval": "(equal ladybird-live-scratch (list (ladybird-live-sent-count \"set_viewport\") (ladybird-live-number \"resizes\") (ladybird-live-number \"h\")))"}, "comment": "the page was not resized"},
    {"keys": "C-g", "delivery": "events"},
    {"eval": "(progn (sleep-for 0.6) t)"},
    {"assert": {"eval": "(equal ladybird-live-scratch (list (ladybird-live-sent-count \"set_viewport\") (ladybird-live-number \"resizes\") (ladybird-live-number \"h\")))"}},

    {"group": "visibility", "comment": "a page no window shows is hidden"},
    {"assert": {"eval": "(equal (ladybird-live-field \"vis\") \"visible\")"}},
    {"eval": "(progn (switch-to-buffer \"*scratch*\") t)"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"vis\") \"hidden\")"},
    {"assert": {"eval": "(eql (ladybird-live-number \"hidden\") 1)"}},
    {"eval": "(progn (switch-to-buffer (ladybird-live-buffer)) t)"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"vis\") \"visible\")"},

    {"group": "focus", "comment": "the page has the focus while its window is selected in a focused frame"},
    {"eval": "(progn (advice-add (quote frame-focus-state) :override (lambda (&rest _) ladybird-live-saved) (quote ((name . ladybird-live)))) (setq ladybird-live-saved t) (ladybird--schedule-update) t)", "comment": "the sandbox's frame need not have the focus of the desktop"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"1\")"},
    {"eval": "(progn (setq ladybird-live-saved nil) (ladybird--focus-changed) t)"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"0\")"},
    {"assert": {"eval": "(>= (ladybird-live-number \"blurs\") 1)"}},
    {"eval": "(progn (setq ladybird-live-saved t) (ladybird--focus-changed) t)"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"1\")"},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
