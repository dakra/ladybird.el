{
  "name": "live-dialogs",
  "comment": "What a page asks of the user, answered both ways: alert, confirm, prompt, a page that asks before it is left, a select element with a group and a disabled item, a file, a colour, a date, and a permission that is granted.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"dialogs.html?do=alert\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"dialogs\")", "timeout": 60},

    {"group": "alert", "comment": "an alert is shown in the echo area and the page goes on"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"alert\") \"done\")"},
    {"assert": {"eval": "(ladybird-live-messages-p \"hello from the page\")"}},
    {"assert": {"eval": "(ladybird-live-received \"dialog\" (quote kind) \"alert\")"}},

    {"group": "confirm", "comment": "a confirmation is answered with y or n"},
    {"eval": "(ladybird-live-load \"dialogs.html?do=confirm\")"},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-suffix-p \": are you sure? — OK? (y or n) \" (minibuffer-prompt))"}},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"confirm\") \"true\")"},
    {"eval": "(ladybird-live-load \"dialogs.html?do=confirm\")"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"do\") \"confirm\")"},
    {"wait": "prompt"},
    {"keys": "n", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"confirm\") \"false\")"},

    {"group": "prompt", "comment": "a prompt returns the text, and null when it is quit"},
    {"eval": "(ladybird-live-load \"dialogs.html?do=prompt\")"},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-contents) \"anon\")"}, "comment": "the default is there to edit"},
    {"type": " ✓"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"prompt\") \"anon ✓\")"},
    {"eval": "(ladybird-live-load \"dialogs.html?do=prompt\")"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"do\") \"prompt\")"},
    {"wait": "prompt"},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"prompt\") \"null\")"},

    {"group": "beforeunload", "comment": "a page that asks before it is left is left only on yes"},
    {"eval": "(ladybird-live-load \"dialogs.html?do=beforeunload\")"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"do\") \"beforeunload\")"},
    {"mouse": "click", "x": 60, "y": 380, "button": 1},
    {"wait": "until", "pred": "(eql (ladybird-live-number \"touched\") 1)", "comment": "the page has seen a click, without which it may not ask"},
    {"eval": "(ladybird-live-load \"second.html\")"},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-suffix-p \": leave this page? (y or n) \" (minibuffer-prompt))"}},
    {"keys": "n", "delivery": "events"},
    {"eval": "(progn (sleep-for 1.0) t)"},
    {"assert": {"eval": "(equal (ladybird-live-field \"page\") \"dialogs\")"}, "comment": "no: the page stays"},
    {"eval": "(ladybird-live-load \"second.html\")"},
    {"wait": "prompt"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"second\")"},

    {"group": "select", "comment": "a select element is answered by completion over its items, groups included"},
    {"eval": "(ladybird-live-load \"dialogs.html\")"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"dialogs\")"},
    {"mouse": "click", "x": 100, "y": 20, "button": 1},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-prompt) \"Select (default Two): \")"}},
    {"assert": {"eval": "(equal (ladybird--select-candidates (alist-get (quote items) (ladybird-live-received \"select\"))) (quote ((\"One\" 1 nil) (\"Two\" 2 t) (\"More / Four\" 4 nil) (\"More / Five\" 5 nil))))"}, "comment": "the disabled item is left out, the group prefixes its items"},
    {"type": "More / Five"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"select\") \"five\")"},
    {"mouse": "click", "x": 100, "y": 20, "button": 1},
    {"wait": "prompt"},
    {"keys": "C-g", "delivery": "events"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(equal (ladybird-live-field \"select\") \"five\")"}, "comment": "a quit changes nothing"},

    {"group": "file", "comment": "the file picker passes a file of the server's machine to the page"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-server-file \"upload.txt\" \"12345\"))"},
    {"mouse": "click", "x": 60, "y": 80, "button": 1},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-prompt) (if (ladybird-live-remote-p) \"Path on live, the server's machine: \" \"File for the page: \"))"}, "comment": "a remote server is asked for a path on its machine"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"eval": "(with-selected-window (active-minibuffer-window) (insert ladybird-live-scratch))"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"file\") (concat (file-name-nondirectory ladybird-live-scratch) \":5\"))", "comment": "the page reads its name and size"},
    {"mouse": "click", "x": 60, "y": 80, "button": 1},
    {"wait": "prompt"},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-live-sent-count \"file_picker_closed\")"},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"file_picker_closed\") 2)"}},

    {"group": "color", "comment": "the colour picker sets the colour"},
    {"mouse": "click", "x": 60, "y": 140, "button": 1},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-prompt) \"Color (default #ff0000): \")"}},
    {"type": "#00ff00"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"color\") \"#00ff00\")"},
    {"mouse": "click", "x": 60, "y": 140, "button": 1},
    {"wait": "prompt"},
    {"keys": "C-g", "delivery": "events"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(equal (ladybird-live-field \"color\") \"#00ff00\")"}},

    {"group": "date", "comment": "the date picker sets the date"},
    {"mouse": "click", "x": 360, "y": 200, "button": 1},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-contents) \"2026-01-02\")"}},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "2026-11-10"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"date\") \"2026-11-10\")"},

    {"group": "permission", "comment": "a permission is granted with a word typed in full"},
    {"mouse": "click", "x": 60, "y": 320, "button": 1},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-match-p \"\\\\`Allow notifications for http://127.0.0.1:[0-9]+\\\\? (allow once, allow always, deny) \\\\'\" (minibuffer-prompt))"}},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "allow once"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"notify\") \"granted\")"},
    {"assert": {"eval": "(ladybird-live-received \"permission\" (quote name) \"notifications\")"}},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"permission_closed\") 1)"}},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
