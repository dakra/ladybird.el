{
  "name": "live-socket",
  "comment": "A server on a socket outlives its clients: a page left there is found again with what was typed into it, a second client detaches this one until it reconnects, and a server that is restarted is dialled again and shows the page anew.",
  "params": {"server": "socket"},
  "variants": {"socket": {"server": "socket"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"form.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"form\")", "timeout": 60},

    {"group": "keep", "comment": "a buffer killed with its page kept leaves the page on the server"},
    {"keys": "i"},
    {"type": "kept"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"kept\")"},
    {"keys": "C-c C-c"},
    {"eval": "(progn (setq ladybird-live-scratch (ladybird-live-conn)) (let ((ladybird-keep-view-on-kill t)) (kill-buffer (ladybird-live-buffer))) t)"},
    {"assert": {"eval": "(and (null (ladybird--buffers)) (null ladybird--conns))"}, "comment": "the connection went with its last buffer"},
    {"assert": {"eval": "(equal (seq-take ladybird-live-sent 2) (quote (\"set_focus\" \"set_visibility\")))"}, "comment": "the page was told it is hidden"},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"close_view\") 0)"}},

    {"group": "reattach", "comment": "connecting again shows the page as it was left"},
    {"eval": "(progn (ladybird-connect \"live\") t)"},
    {"wait": "until", "pred": "(and (ladybird-live-buffer) (ladybird-live-in-page ladybird--canvas) (equal (ladybird-live-field \"page\") \"form\"))"},
    {"assert": {"eval": "(eq (window-buffer) (ladybird-live-buffer))"}, "comment": "the page is shown"},
    {"assert": {"eval": "(equal (ladybird-live-field \"value\") \"kept\")"}, "comment": "what was typed is still there"},
    {"assert": {"eval": "(= (ladybird-live-sent-count \"create_view\") 1)"}, "comment": "no new page was opened"},
    {"assert": {"eval": "(ladybird-live-in-page (= ladybird--view 1))"}},
    {"keys": "i"},
    {"keys": "<end>"},
    {"type": " on"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"kept on\")", "comment": "and typing goes on"},
    {"keys": "C-c C-c"},

    {"group": "replaced", "comment": "a second client detaches this one, which takes the page back on request"},
    {"eval": "(progn (ladybird-live-intrude) t)"},
    {"wait": "until", "pred": "(eq (ladybird--conn-state (ladybird-live-conn)) (quote replaced))"},
    {"assert": {"eval": "(string-suffix-p \" [detached]\" (ladybird-live-header))"}},
    {"assert": {"eval": "(ladybird-live-messages-p \"ladybird: another client took over live\")"}},
    {"eval": "(progn (sleep-for 1.5) t)"},
    {"assert": {"eval": "(eq (ladybird--conn-state (ladybird-live-conn)) (quote replaced))"}, "comment": "it does not dial again by itself"},
    {"eval": "(progn (ladybird-live-in-page (ladybird-reconnect)) t)"},
    {"wait": "until", "pred": "(ladybird--ready-p (ladybird-live-conn))"},
    {"wait": "until", "pred": "(not (process-live-p ladybird-live-intruder))", "timeout": 30, "comment": "now the second client is the one replaced"},
    {"assert": {"eval": "(and (= (length (ladybird--buffers)) 1) (= (ladybird-live-sent-count \"create_view\") 1))"}},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"kept on\")"},

    {"group": "restart", "comment": "a server that is restarted is dialled again and shows the page anew"},
    {"eval": "(progn (ladybird-live-kill-server) t)", "timeout": 60},
    {"wait": "until", "pred": "(eq (ladybird--conn-state (ladybird-live-conn)) (quote redialing))", "timeout": 90},
    {"assert": {"eval": "(string-match-p \" \\\\[reconnecting in [0-9]+s\\\\]\\\\'\" (ladybird-live-header))"}},
    {"eval": "(progn (ladybird-live-serve) t)", "timeout": 120},
    {"wait": "until", "pred": "(= (ladybird-live-sent-count \"create_view\") 2)", "timeout": 90, "comment": "another server process: the buffer asks for a view of its own"},
    {"wait": "until", "pred": "(and (ladybird--ready-p (ladybird-live-conn)) (ladybird-live-page-p \"form\"))", "timeout": 60},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"\")", "comment": "the page is loaded anew"},
    {"assert": {"eval": "(= (length (ladybird--buffers)) 1)"}},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
