{
  "name": "live-session",
  "comment": "A server on the default socket outlives the Emacs that started it: another Emacs opens two pages there, starting the server in the background (socket) or using one started in the background over ssh (forward), and quits; this Emacs finds the server, M-x ladybird-attach brings both pages back with their history, C-c C-d detaches after asking, M-x ladybird-attach and C-c C-a bring them back one by one, and killing a buffer closes its page.",
  "params": {"server": "socket"},
  "variants": {"socket": {"server": "socket"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-live-start-default \"{{server}}\")", "timeout": 120},
    {"assert": {"eval": "(if (equal ladybird-live-variant \"socket\") (not (ladybird-live-default-server-p)) (ladybird-live-default-server-p))"}, "comment": "a local server is not running yet; a remote one runs in the background"},

    {"group": "first", "comment": "another Emacs opens index.html, follows it to second.html, opens index.html in a second page, and quits"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-first-emacs '((\"index.html\" \"second.html\") (\"index.html\"))))", "timeout": 180},
    {"assert": {"eval": "(or (eql 0 ladybird-live-scratch) (error \"%S: %s\" ladybird-live-scratch (with-current-buffer \"*ladybird-live-first*\" (buffer-string))))"}},
    {"assert": {"eval": "(ladybird-live-default-server-p)"}, "comment": "the server outlived it"},
    {"eval": "(setq ladybird-live-saved (ladybird-live-default-server-pid))", "timeout": 30},
    {"assert": {"eval": "(and (null ladybird--conns) (null (ladybird--buffers)))"}},

    {"group": "back", "comment": "M-x ladybird-attach finds the server and brings both pages back as they were left"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird-attach"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(string-prefix-p \"Attach page of \" (or (minibuffer-prompt) \"\"))", "timeout": 60},
    {"type": "All"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(= 2 (length (ladybird-live-pages)))", "timeout": 30},
    {"wait": "until", "pred": "(and (ladybird-live-page-in-p (nth 0 (ladybird-live-pages)) \"second\") (equal (ladybird-live-field-in (nth 1 (ladybird-live-pages)) \"page\") \"index\"))", "timeout": 30},
    {"assert": {"eval": "(eq (window-buffer) (nth 0 (ladybird-live-pages)))"}, "comment": "the first page is shown"},
    {"assert": {"eval": "(= 0 (ladybird-live-sent-count \"create_view\"))"}, "comment": "no page was opened anew"},
    {"assert": {"eval": "(equal (ladybird-live-field-in (nth 0 (ladybird-live-pages)) \"loads\") \"1\")"}, "comment": "nor loaded again"},
    {"assert": {"eval": "(alist-get 'can_go_back (buffer-local-value 'ladybird--state (nth 0 (ladybird-live-pages))))"}, "comment": "its history is there"},
    {"wait": "until", "pred": "(equal (ladybird-live-color-in (nth 0 (ladybird-live-pages)) 10 10) \"#00ffff\")"},
    {"assert": {"eval": "(ladybird-live-shm-as-expected-p)"}},

    {"group": "history", "comment": "back and forward through the history the other Emacs made"},
    {"keys": "C-c C-b", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"index\")", "timeout": 30},
    {"wait": "until", "pred": "(equal (ladybird-live-color 10 10) \"#ff0000\")"},
    {"keys": "C-c C-f", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-live-page-p \"second\")", "timeout": 30},

    {"group": "detach", "comment": "C-c C-d asks, then kills both buffers and closes the connection; the server keeps the pages"},
    {"keys": "C-c C-d", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(string-match-p \"\\\\`Detach 2 pages of .*\\\\? (y or n) \\\\'\" (minibuffer-prompt))"}},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(and (null (ladybird--buffers)) (null ladybird--conns))"},
    {"assert": {"eval": "(= 0 (ladybird-live-sent-count \"close_view\"))"}},
    {"assert": {"eval": "(ladybird-live-messages-p \"ladybird: detached from .*, which keeps its pages\")"}},
    {"assert": {"eval": "(ladybird-live-default-server-p)"}},

    {"group": "attach", "comment": "M-x ladybird-attach gives the page picked a buffer; C-c C-a there offers the other"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird-attach"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(string-prefix-p \"Attach page of \" (or (minibuffer-prompt) \"\"))", "timeout": 60},
    {"type": "second"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (= 1 (length (ladybird-live-pages))) (ladybird-live-page-p \"second\"))", "timeout": 30},
    {"assert": {"eval": "(= 1 (length (ladybird--conn-kept (ladybird-live-conn))))"}, "comment": "the other page stays on the server without a buffer"},
    {"wait": "until", "pred": "(equal (ladybird-live-color 10 10) \"#00ffff\")"},
    {"keys": "C-c C-a", "delivery": "events"},
    {"wait": "until", "pred": "(string-prefix-p \"Attach page of \" (or (minibuffer-prompt) \"\"))", "timeout": 30},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (= 2 (length (ladybird-live-pages))) (ladybird-live-page-p \"index\"))", "timeout": 30},
    {"assert": {"eval": "(eq (window-buffer) (nth 1 (ladybird-live-pages)))"}},
    {"wait": "until", "pred": "(equal (ladybird-live-color 10 10) \"#ff0000\")"},
    {"assert": {"eval": "(and (null (ladybird--conn-kept (ladybird-live-conn))) (= 0 (ladybird-live-sent-count \"create_view\")))"}},

    {"group": "kill", "comment": "killing a page buffer closes its page"},
    {"eval": "(progn (kill-buffer (nth 1 (ladybird-live-pages))) t)"},
    {"wait": "until", "pred": "(= 1 (ladybird-live-sent-count \"close_view\"))"},
    {"assert": {"eval": "(= 1 (length (ladybird-live-pages)))"}},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup", "comment": "the server in the background is stopped"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60},
    {"assert": {"eval": "(if (ladybird-live-remote-p) (not (eql 0 (ladybird-live--remote \"kill\" \"-0\" (number-to-string ladybird-live-saved)))) (null (process-attributes ladybird-live-saved)))", "timeout": 30}}
  ]
}
