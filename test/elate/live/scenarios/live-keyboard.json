{
  "name": "live-keyboard",
  "comment": "Typing into a page with no mode to switch first: letters with and without shift, punctuation, text that has no key, function and cursor keys with modifiers, the Emacs editing and motion keys as this server's platform understands them, paste, C-c C-q for keys Emacs keeps, the keys that stay with Emacs, and command mode.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"form.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"form\")", "timeout": 60},

    {"group": "page-mode", "comment": "keys go to the page from the start"},
    {"assert": {"eval": "(ladybird-live-in-page (and (not ladybird-command-mode) (eq (key-binding \"a\") (quote ladybird-send-key))))"}},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"i\")", "comment": "the input has the focus"},

    {"group": "typing", "comment": "typed keys go into the field"},
    {"type": "Hello, World!"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!\")"},
    {"assert": {"eval": "(= (ladybird-live-number \"keys\") 13)"}},
    {"type": "Z"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"Z\") (= (ladybird-live-number \"mods\") 1))", "comment": "a capital carries shift"},
    {"type": "z"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"z\") (= (ladybird-live-number \"mods\") 0))"},
    {"type": "é日"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!Zzé日\")", "comment": "characters without a key arrive as text"},

    {"group": "function-keys", "comment": "cursor and function keys reach the page with their modifiers"},
    {"keys": "<home>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"0,0\")"},
    {"keys": "S-<right> S-<right>"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"sel\") \"0,2\") (equal (ladybird-live-field \"key\") \"ArrowRight\") (= (ladybird-live-number \"mods\") 1))"},
    {"keys": "<end>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"17,17\")"},
    {"keys": "DEL DEL DEL DEL"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!\")"},
    {"keys": "<left> <delete>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World\")"},
    {"keys": "<f5>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"key\") \"F5\")"},
    {"keys": "<escape>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"key\") \"Escape\")"},

    {"group": "editing", "comment": "the Emacs editing keys edit the field"},
    {"keys": "C-a"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"0,0\")"},
    {"keys": "C-k"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"\")"},
    {"type": "one two three"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"one two three\")"},
    {"keys": "C-a M-f"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"3,3\")", "comment": "M-f moves over a word"},
    {"keys": "M-f M-b"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"4,4\")"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"13,13\")"},
    {"keys": "M-DEL"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"one two \")", "comment": "M-DEL deletes the word before"},
    {"keys": "C-a C-d"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"ne two \")"},
    {"keys": "M-d"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \" two \")", "comment": "M-d deletes the word after"},
    {"keys": "C-<backspace>"},
    {"keys": "C-e C-<backspace>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \" \")"},
    {"keys": "C-/"},
    {"wait": "until", "pred": "(> (length (ladybird-live-field \"value\")) 1)", "comment": "C-/ undoes"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-field \"value\"))"},
    {"keys": "C-?"},
    {"wait": "until", "pred": "(not (equal (ladybird-live-field \"value\") ladybird-live-scratch))", "comment": "C-? redoes"},

    {"group": "textarea", "comment": "TAB moves on, RET breaks the line, C-k joins lines"},
    {"keys": "TAB"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"t\")"},
    {"type": "first"},
    {"keys": "RET"},
    {"type": "second"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"first¶second\")"},
    {"keys": "<up> C-e C-k"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecond\")"},

    {"group": "paste", "comment": "C-y pastes the kill ring as a paste"},
    {"eval": "(kill-new \"pasted ✓\")"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"11,11\")", "comment": "the server does not order a paste after the keys before it, so the caret is awaited"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecondpasted ✓\")"},
    {"assert": {"eval": "(= (ladybird-live-number \"pastes\") 1)"}, "comment": "the page saw a paste event"},

    {"group": "motion", "comment": "the Emacs motion keys move the caret in the textarea: M-< and M-> to its start and end, C-n and C-p by lines, C-a and C-e to a line's ends, C-b and C-f by characters"},
    {"keys": "RET"},
    {"type": "third"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecondpasted ✓¶third\")"},
    {"keys": "M-<"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"0,0\")"},
    {"keys": "C-n"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"20,20\")"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"25,25\")"},
    {"keys": "C-p"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"5,5\")"},
    {"keys": "M->"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"25,25\")"},
    {"keys": "C-a"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"20,20\")"},
    {"keys": "C-b"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"19,19\")"},
    {"keys": "C-f C-f"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"21,21\")"},

    {"group": "next-key", "comment": "C-c C-q sends a key Emacs keeps to the page as it is"},
    {"keys": "C-c C-q C-s", "delivery": "events"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"s\") (= (ladybird-live-number \"mods\") 2))"},
    {"keys": "C-c C-q C-g", "delivery": "events"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"g\") (= (ladybird-live-number \"mods\") 2))"},
    {"assert": {"eval": "(equal (ladybird-live-field \"value\") \"firstsecondpasted ✓¶third\")"}},

    {"group": "emacs-keeps", "comment": "Emacs keeps its prefix and command keys"},
    {"assert": {"eval": "(ladybird-live-in-page (equal (mapcar (lambda (k) (key-binding (kbd k))) (quote (\"C-x C-f\" \"M-x\" \"C-g\" \"C-u\" \"M-:\"))) (quote (find-file execute-extended-command keyboard-quit universal-argument eval-expression))))"}},

    {"group": "command-mode", "comment": "in command mode letters are commands and do not type; i sends keys to the page again"},
    {"keys": "C-c C-e"},
    {"assert": {"eval": "(ladybird-live-in-page ladybird-command-mode)"}},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-number \"keys\"))"},
    {"keys": "a", "delivery": "events"},
    {"eval": "(progn (sleep-for 0.3) t)"},
    {"assert": {"eval": "(= (ladybird-live-number \"keys\") ladybird-live-scratch)"}},
    {"assert": {"eval": "(ladybird-live-messages-p \"Keys are commands here; i sends them to the page again\")"}},
    {"keys": "i"},
    {"type": "!"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecondpasted ✓¶t!hird\")"},

    {"group": "field-focus", "comment": "in command mode a text field that gets the focus sends keys to the page until it loses the focus: by a click, by TAB, by a script a moment after a click, and by autofocus on load"},
    {"eval": "(setq ladybird-live-scratch nil ladybird-field-focus-functions (list (function ladybird-follow-field-focus) (lambda (&rest args) (push args ladybird-live-scratch))))"},
    {"keys": "C-c C-e"},
    {"mouse": "click", "x": 600, "y": 400, "button": 1},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"none\")"},
    {"assert": {"eval": "(ladybird-live-in-page ladybird-command-mode)"}},
    {"mouse": "click", "x": 100, "y": 25, "button": 1},
    {"wait": "until", "pred": "(ladybird-live-in-page (and (not ladybird-command-mode) ladybird--field-page-mode))"},
    {"assert": {"eval": "(equal (car ladybird-live-scratch) (quote (t t)))"}, "comment": "a click gives the page user activation"},
    {"type": "?"},
    {"wait": "until", "pred": "(string-search \"?\" (ladybird-live-field \"value\"))"},
    {"mouse": "click", "x": 600, "y": 400, "button": 1},
    {"wait": "until", "pred": "(ladybird-live-in-page ladybird-command-mode)"},
    {"keys": "TAB"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"focus\") \"i\") (ladybird-live-in-page (not ladybird-command-mode)))"},
    {"assert": {"eval": "(equal (car ladybird-live-scratch) (quote (t t)))"}},
    {"mouse": "click", "x": 600, "y": 400, "button": 1},
    {"wait": "until", "pred": "(ladybird-live-in-page ladybird-command-mode)"},
    {"mouse": "click", "x": 50, "y": 215, "button": 1},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"focus\") \"i\") (ladybird-live-in-page (not ladybird-command-mode)))", "comment": "the button focuses the input 200 ms after the click"},
    {"assert": {"eval": "(equal (car ladybird-live-scratch) (quote (t t)))"}},
    {"mouse": "click", "x": 600, "y": 400, "button": 1},
    {"wait": "until", "pred": "(ladybird-live-in-page ladybird-command-mode)"},
    {"eval": "(progn (ladybird-live-load \"form.html\") t)"},
    {"wait": "until", "pred": "(and (ladybird-live-page-p \"form\") (equal (ladybird-live-field \"focus\") \"i\") (ladybird-live-in-page (not ladybird-command-mode)))"},
    {"assert": {"eval": "(equal (car ladybird-live-scratch) (quote (t nil)))"}, "comment": "autofocus comes without user activation"},
    {"eval": "(setq ladybird-field-focus-functions (list (function ladybird-follow-field-focus)))"},
    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
