{
  "name": "live-keyboard",
  "comment": "Typing into a page: letters with and without shift, punctuation, text that has no key, function and cursor keys with modifiers, the Emacs editing keys as this server's platform understands them, paste, and the keys that stay with Emacs.",
  "params": {"server": "stdio"},
  "variants": {"stdio": {"server": "stdio"}, "socket": {"server": "socket"}, "ssh": {"server": "ssh"}, "forward": {"server": "forward"}},
  "defaults": {"timeout": 20},
  "session": {"ui": "gui", "size": "100x35", "eval_file": ["../lib/ladybird-live.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(progn (ladybird-live-start \"{{server}}\" \"form.html\") t)", "timeout": 120},
    {"wait": "until", "pred": "(ladybird-live-page-p \"form\")", "timeout": 60},

    {"group": "emacs-keys", "comment": "outside insert mode nothing is typed"},
    {"assert": {"eval": "(ladybird-live-in-page (eq (key-binding \"a\") (quote ladybird-self-insert-hint)))"}},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"i\")", "comment": "the input has the focus"},

    {"group": "typing", "comment": "insert mode types into the field"},
    {"keys": "i"},
    {"type": "Hello, World!"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!\")"},
    {"assert": {"eval": "(= (ladybird-live-number \"keys\") 13)"}},
    {"type": "Z"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"Z\") (= (ladybird-live-number \"mods\") 1))", "comment": "a capital carries shift"},
    {"type": "z"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"key\") \"z\") (= (ladybird-live-number \"mods\") 0))"},
    {"type": "é日"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!Zzé日\")", "comment": "characters without a key arrive as text"},

    {"group": "function-keys", "comment": "cursor and function keys reach the page with their modifiers"},
    {"keys": "<home>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"0,0\")"},
    {"keys": "S-<right> S-<right>"},
    {"wait": "until", "pred": "(and (equal (ladybird-live-field \"sel\") \"0,2\") (equal (ladybird-live-field \"key\") \"ArrowRight\") (= (ladybird-live-number \"mods\") 1))"},
    {"keys": "<end>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"17,17\")"},
    {"keys": "DEL DEL DEL DEL"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World!\")"},
    {"keys": "<left> <delete>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"Hello, World\")"},
    {"keys": "<f5>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"key\") \"F5\")"},
    {"keys": "<escape>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"key\") \"Escape\")"},

    {"group": "editing", "comment": "the Emacs editing keys edit the field"},
    {"keys": "C-a"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"0,0\")"},
    {"keys": "C-k"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"\")"},
    {"type": "one two three"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"one two three\")"},
    {"keys": "C-a M-f"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"3,3\")", "comment": "M-f moves over a word"},
    {"keys": "M-f M-b"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"4,4\")"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"13,13\")"},
    {"keys": "M-DEL"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"one two \")", "comment": "M-DEL deletes the word before"},
    {"keys": "C-a C-d"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"ne two \")"},
    {"keys": "M-d"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \" two \")", "comment": "M-d deletes the word after"},
    {"keys": "C-<backspace>"},
    {"keys": "C-e C-<backspace>"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \" \")"},
    {"keys": "C-/"},
    {"wait": "until", "pred": "(> (length (ladybird-live-field \"value\")) 1)", "comment": "C-/ undoes"},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-field \"value\"))"},
    {"keys": "C-?"},
    {"wait": "until", "pred": "(not (equal (ladybird-live-field \"value\") ladybird-live-scratch))", "comment": "C-? redoes"},

    {"group": "textarea", "comment": "TAB moves on, RET breaks the line, C-k joins lines"},
    {"keys": "TAB"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"focus\") \"t\")"},
    {"type": "first"},
    {"keys": "RET"},
    {"type": "second"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"first¶second\")"},
    {"keys": "<up> C-e C-k"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecond\")"},

    {"group": "paste", "comment": "C-y pastes the kill ring as a paste"},
    {"eval": "(kill-new \"pasted ✓\")"},
    {"keys": "C-e"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"sel\") \"11,11\")", "comment": "the server does not order a paste after the keys before it, so the caret is awaited"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(equal (ladybird-live-field \"value\") \"firstsecondpasted ✓\")"},
    {"assert": {"eval": "(= (ladybird-live-number \"pastes\") 1)"}, "comment": "the page saw a paste event"},

    {"group": "leave", "comment": "C-c C-c leaves insert mode; Emacs keeps its keys in it"},
    {"assert": {"eval": "(ladybird-live-in-page (equal (mapcar (lambda (k) (key-binding (kbd k))) (quote (\"C-x C-f\" \"M-x\" \"C-g\" \"C-u\"))) (quote (find-file execute-extended-command keyboard-quit universal-argument))))"}},
    {"eval": "(setq ladybird-live-scratch (ladybird-live-number \"keys\"))"},
    {"keys": "C-c C-c"},
    {"assert": {"eval": "(ladybird-live-in-page (not ladybird-insert-mode))"}},
    {"eval": "(progn (sleep-for 0.3) t)"},
    {"assert": {"eval": "(= (ladybird-live-number \"keys\") ladybird-live-scratch)"}},

    {"group": "health", "comment": "every frame was acknowledged and none dropped"},
    {"eval": "(progn (sleep-for 0.5) t)"},
    {"assert": {"eval": "(ladybird-live-healthy-p)"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-live-cleanup)", "timeout": 60}
  ]
}
