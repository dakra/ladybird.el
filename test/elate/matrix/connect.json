{
  "name": "connect",
  "comment": "A page opens on the mock server over every transport: the buffer gets a view and a canvas of the window's size, takes its name and header line from the page, a second buffer gets its own view, navigation commands reach the server, and closing the buffers closes the views and the connection.",
  "params": {"host": "stdio"},
  "variants": {
    "stdio": {"host": "stdio"},
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "open", "comment": "the page buffer gets a view and its first frame"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"0\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'title) \"Mock: mock://start\")"},
    {"assert": {"eval": "(equal (buffer-name (ladybird-elate-buffer)) \"*ladybird: Mock: mock://start*\")"}},
    {"assert": {"eval": "(equal (ladybird-elate-header) \" mock://start — Mock: mock://start\")"}},
    {"assert": {"eval": "(ladybird-elate-in-page (equal ladybird--canvas-size (cons (window-body-width nil t) (window-body-height nil t))))"}, "comment": "the canvas has the size of the window body"},
    {"assert": {"eval": "(ladybird-elate-logged \"hello\" 'protocol 1)"}},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"create_view\" 'url \"mock://start\"))"}},
    {"assert": {"eval": "(>= (ladybird-elate-count \"frame_ack\") 1)"}, "comment": "the frame was acknowledged"},

    {"group": "navigate", "comment": "C-c C-l loads a URL; the title, name and history follow the page's state"},
    {"keys": "C-c C-l", "delivery": "events"},
    {"wait": "prompt"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "mock://second"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (buffer-name (ladybird-elate-buffer)) \"*ladybird: Mock: mock://second*\")"},
    {"assert": {"eval": "(ladybird-elate-logged \"load\" 'url \"mock://second\")"}},
    {"wait": "until", "pred": "(not (ladybird-elate-state 'loading))"},
    {"keys": "C-c C-b"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"history\" 'delta -1)"},
    {"wait": "until", "pred": "(ladybird-elate-state 'can_go_forward)"},
    {"eval": "(ladybird-elate-in-page (condition-case err (ladybird-back) (user-error (setq ladybird-elate-error (cadr err)))))"},
    {"assert": {"eval": "(equal ladybird-elate-error \"No page to go back to\")"}, "comment": "back with nothing to go back to is an error"},
    {"keys": "C-c C-f"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"history\" 'delta 1)"},
    {"keys": "C-x C-+ C-c C-r"},
    {"wait": "until", "pred": "(and (ladybird-elate-logged \"zoom\" 'op \"in\") (ladybird-elate-logged \"reload\"))"},
    {"wait": "until", "pred": "(> (ladybird-elate-state 'zoom) 1.0)"},
    {"keys": "C-c C-w"},
    {"assert": {"eval": "(equal (current-kill 0) \"mock://second\")"}},

    {"group": "second-buffer", "comment": "C-u C-c C-l opens a URL in a new buffer with its own view"},
    {"keys": "C-u C-c C-l", "delivery": "events"},
    {"wait": "prompt"},
    {"keys": "RET", "delivery": "events", "comment": "the page's URL is the initial input"},
    {"wait": "until", "pred": "(and (= 2 (length (ladybird--buffers))) (seq-every-p (lambda (b) (buffer-local-value 'ladybird--canvas b)) (ladybird--buffers)))"},
    {"assert": {"eval": "(= 1 (length ladybird--conns))"}, "comment": "on the same connection"},
    {"assert": {"eval": "(equal (sort (mapcar (lambda (b) (buffer-local-value 'ladybird--view b)) (ladybird--buffers)) #'<) '(1 2))"}},

    {"group": "close", "comment": "Q in command mode closes the view; the last buffer takes the connection with it"},
    {"keys": "C-c C-e Q"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"close_view\" 'view 2)"},
    {"assert": {"eval": "(= 1 (length ladybird--conns))"}},
    {"eval": "(switch-to-buffer (car (ladybird--buffers)))"},
    {"keys": "C-c C-e Q"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"close_view\" 'view 1)"},
    {"assert": {"eval": "(and (null ladybird--conns) (null (ladybird--buffers)))"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
