{
  "name": "limit",
  "comment": "A server whose welcome has no max_views holds one page: a further page loads in the one there is and is not asked for.",
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start 'stdio \"--fps\" \"0\" \"--no-max-views\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"assert": {"eval": "(ladybird-elate-in-page (= 1 (ladybird--max-views ladybird--conn)))"}},

    {"group": "one-page", "comment": "c in command mode loads the URL in the page there is and says so"},
    {"keys": "C-c C-e c"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"ladybird: mock holds one page; mock://start loaded in\")"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"load\" 'url \"mock://start\")"},
    {"assert": {"eval": "(= 1 (length (ladybird--buffers)))"}},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"create_view\"))"}, "comment": "no view was asked for"},
    {"assert": {"eval": "(eq (window-buffer) (ladybird-elate-buffer))"}},
    {"eval": "(ladybird \"mock://next\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://next\")"},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"create_view\"))"}},
    {"assert": {"eval": "(= 1 (length (ladybird--buffers)))"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
