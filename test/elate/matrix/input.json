{
  "name": "input",
  "comment": "Keys reach the page with no mode to switch first: typing and function keys with their key names, code points and modifiers, Emacs editing and motion keys translated for the server's platform, a prefix argument, non-ASCII text, paste and the selection, C-c C-q for keys Emacs keeps, the keys that stay with Emacs, and command mode with its scroll commands.",
  "params": {"host": "stdio", "platform": "macos", "word": "4", "top": "(\"Up\" 8)", "bottom": "(\"Down\" 8)"},
  "variants": {
    "stdio": {"host": "stdio", "platform": "macos", "word": "4", "top": "(\"Up\" 8)", "bottom": "(\"Down\" 8)"},
    "unix": {"host": "unix", "platform": "linux", "word": "2", "top": "(\"Home\" 2)", "bottom": "(\"End\" 2)"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"0\" \"--platform\" \"{{platform}}\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"eval": "(select-window (get-buffer-window (ladybird-elate-buffer)))"},
    {"eval": "(defun ladybird-elate-downs (&optional from) (mapcar (lambda (m) (list (alist-get 'key m) (alist-get 'modifiers m))) (nthcdr (or from 0) (seq-filter (lambda (m) (equal (alist-get 'kind m) \"down\")) (ladybird-elate-log \"key\")))))"},

    {"group": "page-mode", "comment": "a new buffer sends its keys to the page and says so in the mode line"},
    {"assert": {"eval": "(ladybird-elate-in-page (and (not ladybird-command-mode) (eq (key-binding \"a\") 'ladybird-send-key) (eq (key-binding \"n\") 'ladybird-send-key)))"}},
    {"assert": {"eval": "(ladybird-elate-in-page (equal (substring-no-properties (ladybird--mode-line-process)) \":Page\"))"}},

    {"group": "typing", "comment": "typed keys go with names, code points and modifiers"},
    {"type": "Hello!"},
    {"keys": "RET"},
    {"wait": "until", "pred": "(equal (ladybird-elate-keys) '(\"H\" \"E\" \"L\" \"L\" \"O\" \"ExclamationPoint\" \"Return\"))"},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"H\" 'code_point 72 'modifiers 1)"}, "comment": "a capital carries shift"},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"E\" 'code_point 101 'modifiers 0)"}},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"ExclamationPoint\" 'code_point 33 'modifiers 0)"}},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Return\" 'code_point 10)"}},
    {"assert": {"eval": "(= (ladybird-elate-count \"key\" 'kind \"up\") 7)"}, "comment": "every press is released"},

    {"group": "function-keys", "comment": "function keys go to the page as they are"},
    {"keys": "DEL TAB <left> C-<right> S-<home>"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Home\" 'modifiers 1)"},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Backspace\" 'code_point 8 'modifiers 0)"}},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Tab\" 'code_point 9)"}},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Left\" 'modifiers 0)"}},
    {"assert": {"eval": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Right\" 'modifiers 2)"}},

    {"group": "editing", "comment": "Emacs editing keys are translated for the server's platform ({{platform}})"},
    {"eval": "(setq ladybird-elate-key-count (length (ladybird-elate-keys)))"},
    {"keys": "C-a C-e C-d C-k M-b M-f M-d M-DEL C-<backspace>"},
    {"keys": "C-/ C-z"},
    {"wait": "until", "pred": "(= 2 (ladybird-elate-count \"edit\" 'op \"undo\"))"},
    {"assert": {"eval": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"Home\" 0) (\"End\" 0) (\"Delete\" 0) (\"End\" 1) (\"Delete\" 0) (\"Left\" {{word}}) (\"Right\" {{word}}) (\"Delete\" {{word}}) (\"Backspace\" {{word}}) (\"Backspace\" {{word}})))"}},
    {"assert": {"eval": "(equal (ladybird-elate-in-page (ladybird--platform)) (if (equal \"{{platform}}\" \"macos\") 'macos 'other))"}},

    {"group": "motion", "comment": "the Emacs motion keys are the cursor keys, the page keys and the ends of the page or field"},
    {"eval": "(setq ladybird-elate-key-count (length (ladybird-elate-keys)))"},
    {"keys": "C-n C-p C-b C-f C-v M-v M-< M->"},
    {"wait": "until", "pred": "(= (+ 8 ladybird-elate-key-count) (length (ladybird-elate-keys)))"},
    {"assert": {"eval": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"Down\" 0) (\"Up\" 0) (\"Left\" 0) (\"Right\" 0) (\"PageDown\" 0) (\"PageUp\" 0) {{top}} {{bottom}}))"}},
    {"eval": "(setq ladybird-elate-key-count (length (ladybird-elate-keys)))"},
    {"keys": "C-u 3 x"},
    {"wait": "until", "pred": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"X\" 0) (\"X\" 0) (\"X\" 0)))", "comment": "a numeric prefix argument repeats a key"},

    {"group": "text", "comment": "characters without a key go as text"},
    {"type": "é日"},
    {"wait": "until", "pred": "(and (ladybird-elate-logged \"text\" 'text \"é\") (ladybird-elate-logged \"text\" 'text \"日\"))"},

    {"group": "paste", "comment": "C-y pastes the kill ring, M-w copies the page's selection"},
    {"eval": "(kill-new \"pasted ✓\")"},
    {"keys": "C-y"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"paste\" 'text \"pasted ✓\")"},
    {"keys": "M-w"},
    {"wait": "until", "pred": "(equal (current-kill 0) \"mock selection\")"},

    {"group": "next-key", "comment": "C-c C-q sends a key Emacs keeps, as it is"},
    {"eval": "(setq ladybird-elate-key-count (length (ladybird-elate-keys)))"},
    {"keys": "C-c C-q C-x", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"X\" 2)))", "comment": "C-x is no prefix here"},
    {"keys": "C-c C-q C-g", "delivery": "events"},
    {"keys": "C-c C-q C-s", "delivery": "events"},
    {"wait": "until", "pred": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"X\" 2) (\"G\" 2) (\"S\" 2)))"},
    {"keys": "C-c C-q", "delivery": "raw"},
    {"wait": "until", "pred": "(equal (current-message) \"Key for the page: \")"},
    {"keys": "ESC x", "delivery": "raw", "comment": "the terminal sends M-x as ESC x"},
    {"wait": "until", "pred": "(equal (ladybird-elate-downs ladybird-elate-key-count) '((\"X\" 2) (\"G\" 2) (\"S\" 2) (\"X\" 4)))"},
    {"assert": {"eval": "(= 0 (minibuffer-depth))"}, "comment": "and no M-x prompt opened"},

    {"group": "emacs-keeps", "comment": "prefix and command keys keep their Emacs meaning"},
    {"eval": "(ladybird-elate-in-page (setq ladybird-elate-binding (mapcar (lambda (k) (key-binding (kbd k))) '(\"C-x C-f\" \"M-x\" \"C-g\" \"C-h k\" \"C-u\" \"M-:\"))))"},
    {"assert": {"eval": "(equal ladybird-elate-binding '(find-file execute-extended-command keyboard-quit describe-key universal-argument eval-expression))"}},

    {"group": "command-mode", "comment": "C-c C-e makes single keys commands: n, p, SPC and > scroll at the middle of the canvas, a says how to type; i sends keys to the page again"},
    {"eval": "(setq ladybird-elate-key-count (length (ladybird-elate-log \"key\")))"},
    {"keys": "C-c C-e"},
    {"assert": {"eval": "(ladybird-elate-in-page (and ladybird-command-mode (equal (substring-no-properties (ladybird--mode-line-process)) \":Command\")))"}},
    {"keys": "n"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"mouse\" 'kind \"wheel\" 'dy (* 3 (frame-char-height)) 'x 60)"},
    {"keys": "p"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"mouse\" 'kind \"wheel\" 'dy (* -3 (frame-char-height)))"},
    {"keys": "SPC"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"mouse\" 'kind \"wheel\" 'dy (ladybird-elate-in-page (- (window-body-height (get-buffer-window) t) (frame-char-height))))"},
    {"keys": ">"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"mouse\" 'kind \"wheel\" 'dy 1000000)"},
    {"keys": "x", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"Keys are commands here; i sends them to the page again\")"},
    {"assert": {"eval": "(= ladybird-elate-key-count (length (ladybird-elate-log \"key\")))"}, "comment": "no key reached the page"},
    {"keys": "i"},
    {"assert": {"eval": "(ladybird-elate-in-page (not ladybird-command-mode))"}},
    {"type": "z"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"Z\")"},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
