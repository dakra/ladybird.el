{
  "name": "pages",
  "comment": "Several pages on one server: a second page in its own buffer with its own view, the cookie the pages share, a hidden page getting no frames while the shown one animates and a full frame when shown again, C-c C-s switching by title and URL, a page opened in the background, the welcome's limit, a killed page leaving the others working, and connecting again to a socket server that kept its pages.",
  "params": {"host": "unix"},
  "variants": {
    "unix": {"host": "unix"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"10\" \"--max-views\" \"3\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"eval": "(select-window (get-buffer-window (ladybird-elate-buffer)))"},
    {"eval": "(defun ladybird-elate-page (view) (seq-find (lambda (b) (eql (buffer-local-value 'ladybird--view b) view)) (ladybird--buffers)))"},
    {"eval": "(ladybird-elate-load \"mock://cookie/set/abc\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://cookie/set/abc\")"},

    {"group": "second", "comment": "C-u C-c C-l opens a page in a new buffer on the same server; it reads the cookie the first set"},
    {"keys": "C-u C-c C-l", "delivery": "events"},
    {"wait": "prompt"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "mock://cookie"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (ladybird-elate-page 2) (buffer-local-value 'ladybird--canvas (ladybird-elate-page 2)))"},
    {"assert": {"eval": "(= 2 (length (ladybird--buffers)))"}},
    {"assert": {"eval": "(= 1 (length ladybird--conns))"}, "comment": "on the same connection"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page 2))"}, "comment": "in the selected window"},
    {"wait": "until", "pred": "(equal (alist-get 'title (buffer-local-value 'ladybird--state (ladybird-elate-page 2))) \"Mock: cookie=abc\")"},

    {"group": "hidden", "comment": "the first page, in no window, is told it is hidden and gets no frames while the second animates"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 1 'visible nil)", "comment": "the window change hook ran"},
    {"wait": "idle", "min_idle": 0.3},
    {"eval": "(setq ladybird-elate-key-count (list (ladybird-elate-count \"_frame_sent\" 'view 1) (ladybird-elate-count \"_frame_sent\" 'view 2)))"},
    {"wait": "until", "pred": "(> (ladybird-elate-count \"_frame_sent\" 'view 2) (+ 5 (nth 1 ladybird-elate-key-count)))"},
    {"assert": {"eval": "(= (ladybird-elate-count \"_frame_sent\" 'view 1) (nth 0 ladybird-elate-key-count))"}},

    {"group": "switch", "comment": "C-c C-s reads a page by its title and URL; the page shown again starts with a full frame"},
    {"eval": "(setq ladybird-elate-key-count (ladybird-elate-count \"_frame_sent\" 'view 1 'full t))"},
    {"keys": "C-c C-s", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Page: "}}},
    {"type": "Mock: mock://cookie/set"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(eq (window-buffer (selected-window)) (ladybird-elate-page 1))"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 1 'visible t)"},
    {"wait": "until", "pred": "(> (ladybird-elate-count \"_frame_sent\" 'view 1 'full t) ladybird-elate-key-count)"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 2 'visible nil)"},

    {"group": "background", "comment": "with ladybird-new-page-display background a new page loads in a buffer no window shows"},
    {"eval": "(setq ladybird-new-page-display 'background)"},
    {"eval": "(ladybird \"mock://third\")"},
    {"wait": "until", "pred": "(ladybird-elate-page 3)"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page 1))"}},
    {"assert": {"eval": "(null (get-buffer-window (ladybird-elate-page 3) t))"}},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 3 'visible nil)", "comment": "a page made hidden is told so"},
    {"eval": "(setq ladybird-new-page-display 'selected-window)"},

    {"group": "limit", "comment": "the welcome says 3: a fourth page is refused before it is asked for"},
    {"eval": "(ladybird-elate-in-page (condition-case err (ladybird \"mock://fourth\") (user-error (setq ladybird-elate-error (cadr err)))))"},
    {"assert": {"eval": "(equal ladybird-elate-error \"ladybird: mock has 3 pages open, the most it holds; close one first\")"}},
    {"assert": {"eval": "(= 3 (ladybird-elate-count \"create_view\"))"}},

    {"group": "kill", "comment": "killing one page closes its view; the others go on"},
    {"eval": "(kill-buffer (ladybird-elate-page 3))"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"close_view\" 'view 3)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird-elate-count \"_frame_sent\" 'view 1))"},
    {"wait": "until", "pred": "(> (ladybird-elate-count \"_frame_sent\" 'view 1) (+ 3 ladybird-elate-key-count))"},
    {"type": "k"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"key\" 'view 1 'key \"K\")"},

    {"group": "kept", "comment": "a page left on the server by a killed buffer counts, keeps its state, and comes back with C-c C-s while connected"},
    {"eval": "(let ((ladybird-keep-view-on-kill t)) (kill-buffer (ladybird-elate-page 2)))"},
    {"assert": {"eval": "(equal (mapcar #'car (ladybird--conn-kept (car ladybird--conns))) '(2))"}},
    {"eval": "(ladybird-elate-load \"mock://after\")"},
    {"eval": "(ladybird--send (car ladybird--conns) '((type . \"load\") (view . 2) (url . \"mock://cookie/set/later\")))"},
    {"wait": "until", "pred": "(equal (alist-get 'url (cdr (assq 2 (ladybird--conn-kept (car ladybird--conns))))) \"mock://cookie/set/later\")", "comment": "the kept page's state follows the server's"},
    {"keys": "C-c C-s", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "set/later"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(eq (window-buffer (selected-window)) (ladybird-elate-page 2))"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 2 'visible t)"},
    {"assert": {"eval": "(null (ladybird--conn-kept (car ladybird--conns)))"}},

    {"group": "reattach", "comment": "pages left on a socket server come back as buffers when connecting again"},
    {"eval": "(setq ladybird-keep-view-on-kill t)"},
    {"eval": "(mapc #'kill-buffer (ladybird--buffers))"},
    {"assert": {"eval": "(null ladybird--conns)"}},
    {"assert": {"eval": "(ladybird-elate-messages-p \"ladybird: no page is open here on mock; its server keeps running with 2 pages, which .ladybird-attach. or .ladybird-connect. shows again\")"}},
    {"eval": "(setq ladybird-keep-view-on-kill nil)"},
    {"eval": "(ladybird-connect \"mock\")"},
    {"wait": "until", "pred": "(= 2 (length (ladybird--buffers)))"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"ladybird: 2 pages on mock; C-c C-s switches\")"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page 1))"}, "comment": "the first page is shown"},
    {"assert": {"eval": "(equal (mapcar (lambda (v) (alist-get 'url (buffer-local-value 'ladybird--state (ladybird-elate-page v)))) '(1 2)) '(\"mock://after\" \"mock://cookie/set/later\"))"}},
    {"assert": {"eval": "(= 3 (ladybird-elate-count \"create_view\"))"}, "comment": "no page was made again"},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
