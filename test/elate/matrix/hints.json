{
  "name": "hints",
  "comment": "Following a link from the keyboard: C-c C-o (o in command mode) asks the page for labels, typed characters narrow them, a refused character, DEL, a complete label activates a button, a link, a link in a new buffer with C-u and a field, which leaves command mode; C-g and <escape> cancel, ESC x in a terminal ends the hints and runs M-x, a wheel event ends the hints and scrolls, mouse movement does not end them, the server ends a session or answers with hints_cancelled in place of the labels, a page's question and an alert that waits for a key during the hints, and keys go to the page again once the hints end.",
  "params": {"host": "stdio"},
  "variants": {
    "stdio": {"host": "stdio"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"0\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"eval": "(select-window (get-buffer-window (ladybird-elate-buffer)))"},
    {"eval": "(defun ladybird-elate-hints-p () (and ladybird--hint (not (ladybird--hint-waiting ladybird--hint))))"},
    {"eval": "(defun ladybird-elate-hint-map-p () (ladybird-elate-in-page (eq (key-binding \"z\") 'ladybird-hint-add-char)))"},
    {"eval": "(defun ladybird-elate-page-event (type &rest rest) (ladybird-elate-in-page (setq unread-command-events (append unread-command-events (list (append (list type (posn-at-point 1 (get-buffer-window))) rest))))))"},

    {"group": "narrow", "comment": "C-c C-o sends the alphabet; characters narrow, a character in no label is refused, DEL takes one back, a complete label activates its button"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints\" 'alphabet \"asdfghjkl\")"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"assert": {"eval": "(equal (current-message) \"Hint:   [12 left]\")"}},
    {"assert": {"eval": "(ladybird-elate-hint-map-p)"}},
    {"keys": "s", "delivery": "events", "comment": "a keyboard macro clears the echo area when it ends"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_narrow\" 'prefix \"s\")"},
    {"assert": {"eval": "(equal (current-message) \"Hint: s  [3 left]\")"}},
    {"keys": "x", "delivery": "events", "comment": "the bell would end a keyboard macro"},
    {"wait": "idle", "min_idle": 0.3},
    {"assert": {"eval": "(and (equal (ladybird--hint-prefix ladybird--hint) \"s\") (= 1 (ladybird-elate-count \"hints_narrow\")))"}, "comment": "refused: nothing changed, nothing sent"},
    {"keys": "DEL"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_narrow\" 'prefix \"\")"},
    {"keys": "s a"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"_hint_activated\" 'index 9 'kind \"button\")"},
    {"assert": {"eval": "(ladybird-elate-logged \"hints_end\" 'activate 9)"}},
    {"assert": {"eval": "(and (null ladybird--hint) (not (ladybird-elate-hint-map-p)))"}},

    {"group": "link", "comment": "a link's label loads the link in the page"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"keys": "a a"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"https://mock.invalid/link/1\")"},
    {"assert": {"eval": "(ladybird-elate-logged \"_hint_activated\" 'index 0 'kind \"link\")"}},

    {"group": "new-buffer", "comment": "with C-u a link opens in a new page buffer and the page activates nothing"},
    {"keys": "C-u C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"assert": {"eval": "(equal (current-message) \"Hint (new buffer):   [12 left]\")"}},
    {"keys": "a g"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"create_view\" 'url \"https://mock.invalid/link/5\")"},
    {"wait": "until", "pred": "(= 2 (length (ladybird--buffers)))"},
    {"assert": {"eval": "(and (ladybird-elate-logged \"hints_end\" 'activate nil) (not (ladybird-elate-logged \"_hint_activated\" 'index 4)))"}},
    {"eval": "(kill-buffer (window-buffer (selected-window)))"},
    {"eval": "(switch-to-buffer (car (ladybird--buffers)))"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},

    {"group": "input", "comment": "o in command mode starts the hints too; a field's label leaves command mode, so that keys go to the field"},
    {"keys": "C-c C-e"},
    {"keys": "o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"keys": "a d"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"_hint_activated\" 'index 2 'kind \"input\")"},
    {"assert": {"eval": "(ladybird-elate-in-page (not ladybird-command-mode))"}},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"keys": "a"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_narrow\" 'prefix \"a\" 'id (ladybird--hint-id ladybird--hint))"},
    {"assert": {"eval": "(not (ladybird-elate-logged \"key\" 'key \"A\"))"}, "comment": "the label's characters do not reach the page"},

    {"group": "cancel", "comment": "C-g and <escape> end the hints without a choice"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"keys": "C-g"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count 'activate nil)"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"keys": "<escape>"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count 'activate nil)"},
    {"assert": {"eval": "(not (ladybird-elate-hint-map-p))"}},

    {"group": "events", "comment": "mouse movement leaves the hints open; a wheel event ends them and scrolls the page"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"eval": "(ladybird-elate-page-event 'mouse-movement)"},
    {"wait": "idle", "min_idle": 0.3},
    {"assert": {"eval": "(and ladybird--hint (ladybird-elate-hint-map-p))"}},
    {"eval": "(ladybird-elate-page-event 'wheel-down 1 1 nil)"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"mouse\" 'kind \"wheel\")"},
    {"assert": {"eval": "(ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count 'activate nil)"}},
    {"assert": {"eval": "(and (null ladybird--hint) (not (ladybird-elate-hint-map-p)))"}},

    {"group": "withdrawn", "comment": "the server ends a session with hints_cancelled when it is first narrowed; keys go to the page again"},
    {"eval": "(ladybird-elate-load \"mock://hints-expire\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://hints-expire\")"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"keys": "a", "delivery": "events"},
    {"wait": "until", "pred": "(null ladybird--hint)"},
    {"assert": {"eval": "(not (ladybird-elate-hint-map-p))"}},
    {"assert": {"eval": "(equal (current-message) \"The page ended the hint session\")"}},
    {"assert": {"eval": "(not (ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count))"}},
    {"keys": "s"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"key\" 'kind \"down\" 'key \"S\")", "comment": "s goes to the page"},

    {"group": "timeout", "comment": "hints_cancelled in place of the labels, 3 seconds after hints, ends the session that waits for them"},
    {"eval": "(ladybird-elate-load \"mock://hints-timeout\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://hints-timeout\")"},
    {"keys": "C-c C-o"},
    {"assert": {"eval": "(and ladybird--hint (ladybird--hint-waiting ladybird--hint))"}},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"wait": "until", "pred": "(null ladybird--hint)"},
    {"assert": {"eval": "(and (not (ladybird-elate-hint-map-p)) (not (ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count)))"}},
    {"assert": {"eval": "(equal (current-message) \"The page ended the hint session\")"}},

    {"group": "dialog", "comment": "a page's question during the hints opens the minibuffer: the hints end and the answer goes to the question"},
    {"eval": "(ladybird-elate-load \"mock://hints-confirm\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://hints-confirm\")"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"keys": "s", "delivery": "events", "comment": "the first narrowing makes the page ask"},
    {"wait": "prompt"},
    {"assert": {"eval": "(and (null ladybird--hint) (ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count 'activate nil))"}},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'accepted t)"},
    {"assert": {"eval": "(not (ladybird-elate-logged \"hints_narrow\" 'prefix \"sy\"))"}},

    {"group": "alert", "comment": "an alert that waits for a key hides the keymaps while the server ends the hints; afterwards keys go to the page, with no loop"},
    {"eval": "(setq ladybird-alert-style 'prompt)"},
    {"eval": "(ladybird-elate-load \"mock://hints-alert\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://hints-alert\")"},
    {"eval": "(setq ladybird-elate-binding (length (ladybird-elate-log \"dialog_closed\")))"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"keys": "s", "delivery": "events"},
    {"wait": "until", "pred": "(null ladybird--hint)", "comment": "ended while the alert waits for its key"},
    {"assert": {"eval": "(= ladybird-elate-binding (length (ladybird-elate-log \"dialog_closed\")))"}},
    {"keys": "x", "delivery": "raw"},
    {"wait": "until", "pred": "(< ladybird-elate-binding (length (ladybird-elate-log \"dialog_closed\")))"},
    {"eval": "(setq ladybird-elate-key-count (ladybird-elate-count \"key\" 'kind \"down\" 'key \"N\"))"},
    {"keys": "n", "delivery": "raw"},
    {"wait": "until", "pred": "(< ladybird-elate-key-count (ladybird-elate-count \"key\" 'kind \"down\" 'key \"N\"))"},
    {"assert": {"eval": "(not (ladybird-elate-in-page (eq (key-binding \"z\") 'ladybird-hint-add-char)))"}},
    {"eval": "(setq ladybird-alert-style 'echo)"},

    {"group": "terminal", "comment": "keys typed on the terminal: a refused character, DEL, and ESC x, which is M-x there: it ends the hints and runs"},
    {"eval": "(ladybird-elate-load \"mock://start\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://start\")"},
    {"keys": "C-c C-o", "delivery": "raw"},
    {"wait": "until", "pred": "(ladybird-elate-hints-p)"},
    {"eval": "(setq ladybird-elate-key-count (ladybird--hint-id ladybird--hint))"},
    {"keys": "a", "delivery": "raw"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_narrow\" 'prefix \"a\" 'id ladybird-elate-key-count)"},
    {"keys": "z", "delivery": "raw"},
    {"keys": "DEL", "delivery": "raw"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"hints_narrow\" 'prefix \"\" 'id ladybird-elate-key-count)"},
    {"assert": {"eval": "(= 2 (ladybird-elate-count \"hints_narrow\" 'id ladybird-elate-key-count))"}, "comment": "z changed nothing"},
    {"assert": {"eval": "(equal (current-message) \"Hint:   [12 left]\")"}},
    {"keys": "ESC x", "delivery": "raw"},
    {"wait": "prompt"},
    {"assert": {"eval": "(ladybird-elate-logged \"hints_end\" 'id ladybird-elate-key-count 'activate nil)"}},
    {"assert": {"eval": "(and (null ladybird--hint) (not (ladybird-elate-hint-map-p)))"}},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(= 0 (minibuffer-depth))"},

    {"group": "empty", "comment": "a page with nothing to label says so"},
    {"eval": "(ladybird-elate-load \"mock://hints-0\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://hints-0\")"},
    {"keys": "C-c C-o"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"^No hints in view$\")"},
    {"assert": {"eval": "(and (null ladybird--hint) (not (ladybird-elate-hint-map-p)))"}},
    {"assert": {"eval": "(not (ladybird-elate-logged \"error\"))"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
