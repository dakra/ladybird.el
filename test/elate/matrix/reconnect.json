{
  "name": "reconnect",
  "comment": "A connection that is lost and a server that goes away and comes back: the buffer shows the redial, keeps its view when the server lived on, and gets a new view from another server process; a second client detaches the first, which takes the server back on request; a local server that exits is reported with its status.",
  "params": {"host": "unix"},
  "variants": {
    "unix": {"host": "unix"},
    "tcp": {"host": "tcp"}
  },
  "defaults": {"timeout": 20},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"0\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"eval": "(ladybird-elate-in-page (setq ladybird-elate-canvas ladybird--canvas))"},

    {"group": "reattach", "comment": "the connection is lost and the server lives on: the buffer keeps its view"},
    {"eval": "(ladybird-elate-load \"mock://disconnect\")"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (eq (ladybird--conn-state ladybird--conn) 'redialing))"},
    {"assert": {"eval": "(string-match-p \" \\\\[reconnecting in [0-9]+s\\\\]\\\\'\" (ladybird-elate-header))"}},
    {"assert": {"eval": "(ladybird-elate-in-page (eq (get-text-property 1 'display) ladybird-elate-canvas))"}, "comment": "the last frame stays"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (ladybird--ready-p ladybird--conn))"},
    {"wait": "until", "pred": "(= 2 (ladybird-elate-count \"hello\"))"},
    {"assert": {"eval": "(= 1 (length (ladybird--buffers)))"}, "comment": "no new buffer"},
    {"assert": {"eval": "(ladybird-elate-in-page (= ladybird--view 1))"}},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"create_view\"))"}, "comment": "and no new view"},
    {"assert": {"eval": "(equal (ladybird-elate-state 'url) \"mock://disconnect\")"}},
    {"assert": {"eval": "(not (string-match-p \"\\\\[\" (ladybird-elate-header)))"}},
    {"type": "k"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"key\" 'key \"K\")", "comment": "and typing works again"},

    {"group": "recreate", "comment": "another server process answers, with a view of the same id: that is another page, and the buffer gets a new view with its URL"},
    {"eval": "(setq ladybird-elate-canvas (ladybird-elate-buffer))"},
    {"eval": "(ladybird-elate-kill-server)"},
    {"wait": "until", "pred": "(with-current-buffer ladybird-elate-canvas (eq (ladybird--conn-state ladybird--conn) 'redialing))"},
    {"eval": "(ladybird-elate-serve '{{host}} \"--fps\" \"0\" \"--views\" \"1\")"},
    {"wait": "until", "pred": "(= 2 (ladybird-elate-count \"create_view\"))"},
    {"assert": {"eval": "(ladybird-elate-logged \"create_view\" 'url \"mock://disconnect\")"}},
    {"wait": "until", "pred": "(with-current-buffer ladybird-elate-canvas (and ladybird--canvas (eql ladybird--view 2)))"},
    {"wait": "until", "pred": "(= 4 (ladybird-elate-count \"hello\"))", "comment": "the new view opened mock://disconnect too, which drops this connection once more"},
    {"wait": "until", "pred": "(with-current-buffer ladybird-elate-canvas (ladybird--ready-p ladybird--conn))", "comment": "and it is dialled again before a second client comes"},
    {"assert": {"eval": "(= 2 (length (ladybird--buffers)))"}, "comment": "the server's own page has a buffer of its own"},
    {"assert": {"eval": "(equal (sort (mapcar (lambda (b) (alist-get 'url (buffer-local-value 'ladybird--state b))) (ladybird--buffers)) #'string<) '(\"mock://disconnect\" \"mock://view/1\"))"}},
    {"eval": "(kill-buffer (seq-find (lambda (b) (not (eq b ladybird-elate-canvas))) (ladybird--buffers)))"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"close_view\" 'view 1)"},
    {"eval": "(progn (switch-to-buffer ladybird-elate-canvas) (setq ladybird--last-buffer ladybird-elate-canvas))"},
    {"assert": {"eval": "(= 1 (length (ladybird--buffers)))"}},

    {"group": "replaced", "comment": "a second client detaches this one, which does not redial by itself"},
    {"eval": "(ladybird-elate-intrude)"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (eq (ladybird--conn-state ladybird--conn) 'replaced))"},
    {"assert": {"eval": "(string-suffix-p \" [detached]\" (ladybird-elate-header))"}},
    {"assert": {"eval": "(ladybird-elate-messages-p \"ladybird: another client took over mock\")"}},
    {"wait": "idle", "min_idle": 1.5},
    {"assert": {"eval": "(ladybird-elate-in-page (eq (ladybird--conn-state ladybird--conn) 'replaced))"}},
    {"eval": "(ladybird-elate-in-page (ladybird-reconnect))"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (ladybird--ready-p ladybird--conn))"},
    {"assert": {"eval": "(and (= 1 (length (ladybird--buffers))) (= 2 (ladybird-elate-count \"create_view\")))"}, "comment": "the view is taken over again"},
    {"wait": "until", "pred": "(not (process-live-p ladybird-elate-intruder))", "comment": "and the second client is the one replaced"},

    {"group": "exit", "comment": "a local server that exits is reported with its status and not started again"},
    {"eval": "(ladybird-elate-cleanup)"},
    {"eval": "(ladybird-elate-start 'stdio \"--fps\" \"0\" \"--exit-after\" \"1.5\" \"--exit-code\" \"3\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"ladybird: the server on mock exited with status 3\")"},
    {"assert": {"eval": "(ladybird-elate-in-page (eq (ladybird--conn-state ladybird--conn) 'closed))"}},
    {"assert": {"eval": "(string-suffix-p \" [disconnected]\" (ladybird-elate-header))"}},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
