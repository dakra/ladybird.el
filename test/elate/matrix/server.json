{
  "name": "server",
  "comment": "The local server on the default socket, with the mock server as ladybird-program: M-x ladybird without a server asks to start one, y starts it in the background and opens the page there, a second page goes to it without asking; C-c C-d asks before it detaches, n keeps the pages and y leaves them on the server; M-x ladybird-connect brings them back, C-u C-c C-d detaches one, C-c C-s shows it again; ladybird-start-server finds the running server; with the server gone, n gives a server over standard input and output with a note once, detaching from it is refused, and ladybird-start-server sends the next page to the socket while those pages stay.",
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-local \"--fps\" \"0\")"},
    {"assert": {"eval": "(equal (ladybird-default-socket) (concat ladybird-elate-runtime \"/ladybird-emacs.sock\"))"}},
    {"assert": {"eval": "(not (ladybird--socket-live-p (ladybird-default-socket)))"}},
    {"eval": "(defun ladybird-elate-page (url) (seq-find (lambda (b) (equal (with-current-buffer b (ladybird--url)) url)) (ladybird--buffers)))"},
    {"eval": "(defun ladybird-elate-socket-conn-p (conn) (equal (ladybird--conn-endpoints conn) (list (list :kind 'unix :path (ladybird-default-socket)))))"},
    {"eval": "(defun ladybird-elate-said (text) (with-current-buffer (messages-buffer) (how-many (regexp-quote text) (point-min) (point-max))))"},

    {"group": "autostart", "comment": "M-x ladybird finds no server and asks; y starts the mock in the background on the default socket and opens the page there"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"URL (default about:blank): \")"},
    {"type": "mock://one"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"No Ladybird server is running.  Start one? (y or n) \")"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"assert": {"eval": "(ladybird-elate-socket-conn-p (car ladybird--conns))"}, "comment": "the local server, found on the default socket"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page \"mock://one\"))"}},
    {"assert": {"eval": "(= 1 (ladybird-elate-said (format \"ladybird: started a server on %s, logging to %s\" (ladybird-default-socket) ladybird-elate-log)))"}},
    {"assert": {"eval": "(= 1 (length (ladybird-elate-background-pids)))"}},
    {"assert": {"eval": "(not (memql (car (ladybird-elate-background-pids)) (mapcar #'process-id (process-list))))"}, "comment": "the server is no process of this Emacs"},
    {"assert": {"eval": "(eq t (alist-get 'shm (car (ladybird-elate-log \"hello\"))))"}, "comment": "a server on this machine is offered shared memory"},

    {"group": "second", "comment": "a second page goes to the same server without asking"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"URL (default about:blank): \")"},
    {"type": "mock://two"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (ladybird-elate-page \"mock://two\") (buffer-local-value 'ladybird--canvas (ladybird-elate-page \"mock://two\")))"},
    {"assert": {"eval": "(= 0 (minibuffer-depth))"}},
    {"assert": {"eval": "(and (= 1 (length ladybird--conns)) (= 1 (ladybird-elate-count \"hello\")) (= 2 (ladybird-elate-count \"create_view\")))"}},

    {"group": "detach", "comment": "C-c C-d asks; n keeps everything, y kills both buffers and closes the connection without closing a page"},
    {"keys": "C-c C-d", "delivery": "events"},
    {"wait": "prompt"},
    {"assert": {"eval": "(equal (minibuffer-prompt) (format \"Detach 2 pages of %s? (y or n) \" (ladybird-default-socket)))"}},
    {"keys": "n", "delivery": "events"},
    {"wait": "until", "pred": "(= 0 (minibuffer-depth))"},
    {"assert": {"eval": "(and (= 2 (length (ladybird--buffers))) (ladybird--ready-p (car ladybird--conns)))"}},
    {"keys": "C-c C-d", "delivery": "events"},
    {"wait": "prompt"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(and (null (ladybird--buffers)) (null ladybird--conns))"},
    {"wait": "until", "pred": "(ladybird-elate-log \"_disconnected\")"},
    {"assert": {"eval": "(ladybird-elate-messages-p (concat (regexp-quote (format \"ladybird: detached from %s, which keeps its pages; \" (ladybird-default-socket))) \".ladybird-attach. or .ladybird-connect. shows them again\"))"}},
    {"assert": {"eval": "(null (ladybird-elate-log \"close_view\"))"}},
    {"assert": {"eval": "(ladybird--socket-live-p (ladybird-default-socket))"}, "comment": "the server keeps running"},
    {"wait": "idle", "min_idle": 1.5},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"hello\"))"}, "comment": "a detached connection is not dialled again"},

    {"group": "connect", "comment": "M-x ladybird-connect reads the host and gives both pages their buffers again"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird-connect"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"Host: \")"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (ladybird-elate-page \"mock://one\") (ladybird-elate-page \"mock://two\"))"},
    {"assert": {"eval": "(= 2 (ladybird-elate-count \"create_view\"))"}, "comment": "no page was made again"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page \"mock://one\"))"}, "comment": "the page buffer used last is gone, so the first page"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p (regexp-quote (format \"ladybird: 2 pages on %s; C-c C-s switches\" (ladybird-default-socket))))"},

    {"group": "detach-one", "comment": "C-u C-c C-d kills only this buffer; its page stays on the server until C-c C-s shows it"},
    {"keys": "C-u C-c C-d", "delivery": "events"},
    {"wait": "until", "pred": "(null (ladybird-elate-page \"mock://one\"))"},
    {"assert": {"eval": "(= 0 (minibuffer-depth))"}, "comment": "nothing asked"},
    {"assert": {"eval": "(and (= 1 (length (ladybird--buffers))) (ladybird--ready-p (car ladybird--conns)) (= 1 (length (ladybird--conn-kept (car ladybird--conns)))))"}},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"detached; C-c C-s shows its page again\")"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"set_visibility\" 'view 1 'visible nil)"},
    {"assert": {"eval": "(null (ladybird-elate-log \"close_view\"))"}},
    {"eval": "(switch-to-buffer (ladybird-elate-page \"mock://two\"))"},
    {"keys": "C-c C-s", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"Page: \")"},
    {"type": "mock://one"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-page \"mock://one\")"},
    {"assert": {"eval": "(eq (window-buffer (selected-window)) (ladybird-elate-page \"mock://one\"))"}},
    {"assert": {"eval": "(and (= 2 (length (ladybird--buffers))) (= 2 (ladybird-elate-count \"create_view\")))"}},

    {"group": "running", "comment": "ladybird-start-server leaves a running server as it is"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird-start-server"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p (regexp-quote (format \"ladybird: a server runs on %s already\" (ladybird-default-socket))))"},
    {"assert": {"eval": "(= 1 (length (ladybird-elate-background-pids)))"}},

    {"group": "decline", "comment": "with the server gone, n gives a server over standard input and output and the note that its pages end with Emacs"},
    {"keys": "C-c C-d", "delivery": "events"},
    {"wait": "prompt"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(null ladybird--conns)"},
    {"eval": "(ladybird-elate-stop-background)"},
    {"assert": {"eval": "(not (ladybird--socket-live-p (ladybird-default-socket)))"}},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"URL (default about:blank): \")"},
    {"type": "mock://three"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"No Ladybird server is running.  Start one? (y or n) \")"},
    {"keys": "n", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},
    {"assert": {"eval": "(ladybird--stdio-conn-p (car ladybird--conns))"}},
    {"assert": {"eval": "(null (ladybird-elate-background-pids))"}, "comment": "nothing was started in the background"},
    {"assert": {"eval": "(= 1 (ladybird-elate-said (format \"ladybird: no server on %s; pages end with Emacs\" (ladybird-default-socket))))"}},
    {"eval": "(let ((ladybird-new-page-display 'background)) (ladybird \"mock://four\"))"},
    {"wait": "until", "pred": "(and (ladybird-elate-page \"mock://four\") (buffer-local-value 'ladybird--canvas (ladybird-elate-page \"mock://four\")))"},
    {"assert": {"eval": "(and (= 1 (length ladybird--conns)) (= 0 (minibuffer-depth)))"}, "comment": "the same connection, nothing asked"},
    {"assert": {"eval": "(= 1 (ladybird-elate-said (format \"ladybird: no server on %s; pages end with Emacs\" (ladybird-default-socket))))"}, "comment": "said once for the connection"},
    {"keys": "C-c C-d", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p \"The server on local talks over standard input and output; its pages end with the connection\")"},
    {"assert": {"eval": "(= 2 (length (ladybird--buffers)))"}, "comment": "detaching from it is refused"},

    {"group": "start", "comment": "M-x ladybird-start-server: new pages go to the socket, the pages over stdio stay"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird-start-server"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-messages-p (regexp-quote (format \"ladybird: started a server on %s, logging to %s; new pages open there, the 2 pages open over stdio stay until they are closed\" (ladybird-default-socket) ladybird-elate-log)))"},
    {"assert": {"eval": "(= 1 (length (ladybird-elate-background-pids)))"}},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "ladybird"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"URL (default about:blank): \")"},
    {"type": "mock://five"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(and (ladybird-elate-page \"mock://five\") (buffer-local-value 'ladybird--canvas (ladybird-elate-page \"mock://five\")))"},
    {"assert": {"eval": "(= 0 (minibuffer-depth))"}},
    {"assert": {"eval": "(ladybird-elate-socket-conn-p (buffer-local-value 'ladybird--conn (ladybird-elate-page \"mock://five\")))"}},
    {"assert": {"eval": "(and (ladybird--stdio-conn-p (buffer-local-value 'ladybird--conn (ladybird-elate-page \"mock://three\"))) (ladybird--stdio-conn-p (buffer-local-value 'ladybird--conn (ladybird-elate-page \"mock://four\"))))"}, "comment": "the pages over stdio stay there"},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"},
    {"assert": {"eval": "(and (null (ladybird-elate-background-pids)) (not (file-exists-p ladybird-elate-runtime)))"}}
  ]
}
