{
  "name": "ui",
  "comment": "What a page asks of the user: alert, confirm, prompt and a quit out of it, select, file picker, permission and its withdrawal, external URL, a request the server withdraws, a prompt that waits for the minibuffer, and the page's events: clipboard, hover, console; and find in page.",
  "params": {"host": "stdio"},
  "variants": {
    "stdio": {"host": "stdio"},
    "unix": {"host": "unix"}
  },
  "defaults": {"timeout": 15},
  "session": {"ui": "tty", "size": "120x36", "eval_file": ["../lib/ladybird-setup.el"]},
  "steps": [
    {"group": "setup"},
    {"eval": "(ladybird-elate-start '{{host}} \"--fps\" \"0\")"},
    {"wait": "until", "pred": "(ladybird-elate-ready-p)"},

    {"group": "alert", "comment": "an alert is shown and accepted at once"},
    {"eval": "(ladybird-elate-load \"mock://alert\")"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'id 1 'accepted t)"},
    {"assert": {"eval": "(ladybird-elate-messages-p \"^mock://alert: Mock alert$\")"}},

    {"group": "confirm", "comment": "y accepts a confirmation"},
    {"eval": "(ladybird-elate-load \"mock://confirm\")"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "mock://confirm: Mock confirm — OK? (y or n) "}}},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'id 2 'accepted t)"},

    {"group": "prompt", "comment": "a prompt returns the text; C-g declines"},
    {"eval": "(ladybird-elate-load \"mock://prompt\")"},
    {"wait": "prompt"},
    {"type": " and more"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'id 3 'accepted t 'text \"mock default and more\")"},
    {"eval": "(ladybird-elate-load \"mock://prompt\")"},
    {"wait": "prompt"},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'id 4 'accepted nil)"},

    {"group": "select", "comment": "a select completes over the enabled items"},
    {"eval": "(ladybird-elate-load \"mock://select\")"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Select (default Two): "}}},
    {"type": "More"},
    {"keys": "TAB RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"select_closed\" 'id 5 'item 4)"},
    {"eval": "(ladybird-elate-load \"mock://select\")"},
    {"wait": "prompt"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"select_closed\" 'id 6 'item 2)", "comment": "RET takes the selected item"},

    {"group": "file", "comment": "the file picker answers with an absolute path"},
    {"eval": "(with-temp-file \"~/upload.txt\" (insert \"x\"))"},
    {"eval": "(ladybird-elate-load \"mock://file\")"},
    {"wait": "prompt"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "~/upload.txt"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(equal (alist-get 'paths (ladybird-elate-logged \"file_picker_closed\" 'id 7)) (vector (expand-file-name \"~/upload.txt\")))"},

    {"group": "permission", "comment": "a permission is answered with a word typed in full, and a withdrawn request closes its prompt unanswered"},
    {"eval": "(ladybird-elate-load \"mock://permission\")"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Allow geolocation for mock://permission? (allow once, allow always, deny) "}}},
    {"keys": "a RET", "delivery": "events"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(null (ladybird-elate-logged \"permission_closed\" 'id 8))"}, "comment": "a part of a choice does not answer"},
    {"assert": {"state": {"minibuffer.prompt": "Type a choice in full: Allow geolocation for mock://permission? (allow once, allow always, deny) "}}, "comment": "the question is asked again"},
    {"keys": "C-a C-k", "delivery": "events"},
    {"type": "allow always"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"permission_closed\" 'id 8 'outcome \"allow_always\")"},
    {"eval": "(ladybird-elate-load \"mock://permission-cancel\")"},
    {"wait": "prompt"},
    {"wait": "until", "pred": "(= 0 (recursion-depth))", "comment": "the prompt goes away by itself"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(null (ladybird-elate-logged \"permission_closed\" 'id 9))"}},

    {"group": "external", "comment": "an external URL is opened on the server or denied"},
    {"eval": "(ladybird-elate-load \"mock://external\")"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "Open mailto:someone@example.com with Mail? (open on server, open here, deny) "}}},
    {"type": "deny"},
    {"keys": "RET", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"external_url_closed\" 'id 10 'open nil)"},

    {"group": "withdrawn", "comment": "a request the server withdraws closes its prompt and gets no answer"},
    {"eval": "(ladybird-elate-load \"mock://cancel-prompt\")"},
    {"wait": "prompt"},
    {"assert": {"state": {"minibuffer.prompt": "mock://prompt: Mock prompt: "}}},
    {"wait": "until", "pred": "(= 0 (recursion-depth))"},
    {"wait": "idle", "min_idle": 0.5},
    {"assert": {"eval": "(null (ladybird-elate-logged \"dialog_closed\" 'id 11))"}},

    {"group": "minibuffer-busy", "comment": "a prompt waits while the minibuffer is in use; the page's request is neither declined nor lost"},
    {"eval": "(setq enable-recursive-minibuffers nil)", "comment": "the default; the sandbox turns it on"},
    {"keys": "M-x", "delivery": "events"},
    {"wait": "prompt"},
    {"eval": "(ladybird-elate-load \"mock://confirm\")"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"load\" 'url \"mock://confirm\")"},
    {"wait": "idle", "min_idle": 0.8},
    {"assert": {"state": {"minibuffer.prompt": "M-x "}}, "comment": "the minibuffer is left alone"},
    {"assert": {"eval": "(null (ladybird-elate-logged \"dialog_closed\" 'id 12))"}},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(equal (minibuffer-prompt) \"mock://confirm: Mock confirm — OK? (y or n) \")", "comment": "now the page's question opens"},
    {"keys": "y", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"dialog_closed\" 'id 12 'accepted t)"},
    {"eval": "(setq enable-recursive-minibuffers t)"},

    {"group": "events", "comment": "clipboard, pointer shape and console output"},
    {"eval": "(ladybird-elate-load \"mock://clipboard\")"},
    {"wait": "until", "pred": "(equal (current-kill 0) \"mock clipboard\")"},
    {"eval": "(ladybird-elate-load \"mock://hover\")"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (eq (get-text-property 1 'pointer) 'hand))"},
    {"keys": "C-c C-t"},
    {"wait": "text", "pattern": "\\[log\\] console enabled", "buffer": "*ladybird-console*"},
    {"assert": {"eval": "(ladybird-elate-logged \"set_console\" 'enabled t)"}},

    {"group": "find", "comment": "C-s searches as the string is typed, steps with C-s and C-r, RET keeps the matches and C-g ends the search"},
    {"eval": "(ladybird-elate-load \"mock://ooo\")"},
    {"wait": "until", "pred": "(equal (ladybird-elate-state 'url) \"mock://ooo\")"},
    {"eval": "(select-window (get-buffer-window (ladybird-elate-buffer)))"},
    {"keys": "C-s", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "o"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"find\" 'query \"o\" 'case_sensitive nil 'highlight_all t)", "comment": "sent after the debounce"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (equal ladybird--find-result '(1 . 4)))"},
    {"assert": {"eval": "(equal (overlay-get ladybird--find-overlay 'after-string) \" [1/4]\")"}, "comment": "the count shows in the minibuffer"},
    {"keys": "C-s", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (equal ladybird--find-result '(2 . 4)))"},
    {"keys": "C-r C-r", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (equal ladybird--find-result '(4 . 4)))"},
    {"assert": {"eval": "(and (= 1 (ladybird-elate-count \"find_step\" 'direction \"next\")) (= 2 (ladybird-elate-count \"find_step\" 'direction \"previous\")))"}},
    {"keys": "RET", "delivery": "events"},
    {"wait": "idle"},
    {"assert": {"eval": "(= 1 (ladybird-elate-count \"find\"))"}, "comment": "RET sends nothing more"},
    {"keys": "M-s n"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (equal ladybird--find-result '(1 . 4)))"},
    {"keys": "C-s", "delivery": "events"},
    {"wait": "prompt"},
    {"type": "zz"},
    {"wait": "until", "pred": "(ladybird-elate-in-page (equal ladybird--find-result '(0 . 0)))"},
    {"keys": "C-g", "delivery": "events"},
    {"wait": "until", "pred": "(ladybird-elate-logged \"find\" 'query \"\")"},

    {"group": "cleanup"},
    {"eval": "(ladybird-elate-cleanup)"}
  ]
}
