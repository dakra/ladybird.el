;;; ladybird-keys-test.el --- Tests for ladybird-keys -*- lexical-binding: t; -*-

;;; Commentary:

;; ERT tests of the event translation.

;;; Code:

(require 'ert)
(require 'ladybird-keys)

;; An Emacs without a window system does not preload mwheel.
(defvar mouse-wheel-flip-direction)

(ert-deftest ladybird-keys-test-letters ()
  (should (equal (ladybird-keys-event ?a) '("A" 97 0)))
  (should (equal (ladybird-keys-event ?A) '("A" 65 1)))
  (should (equal (ladybird-keys-event ?Z) '("Z" 90 1)))
  (should (equal (ladybird-keys-event ?\C-a) '("A" 97 2)))
  (should (equal (ladybird-keys-event ?\M-a) '("A" 97 4)))
  (should (equal (ladybird-keys-event ?\C-\M-z) '("Z" 122 6)))
  (should (equal (ladybird-keys-event ?\s-c) '("C" 99 8)))
  (should (equal (ladybird-keys-event ?a t) '("A" 97 4))))

(ert-deftest ladybird-keys-test-digits-and-punctuation ()
  (should (equal (ladybird-keys-event ?7) '("7" 55 0)))
  (should (equal (ladybird-keys-event ?!) '("ExclamationPoint" 33 0)))
  (should (equal (ladybird-keys-event ?\s) '("Space" 32 0)))
  (should (equal (ladybird-keys-event ?\C-/) '("Slash" 47 2)))
  (should (equal (ladybird-keys-event ?~) '("Tilde" 126 0)))
  (dolist (entry ladybird-keys--punctuation)
    (should (equal (ladybird-keys-event (car entry))
                   (list (cdr entry) (car entry) 0)))))

(ert-deftest ladybird-keys-test-text ()
  (should (equal (ladybird-keys-event ?é) '(text "é")))
  (should (equal (ladybird-keys-event ?É) '(text "É")))
  (should (equal (ladybird-keys-event ?日) '(text "日")))
  (should (equal (ladybird-keys-event ?🦋) '(text "🦋")))
  (should-not (ladybird-keys-event (event-convert-list '(control ?é)))))

(ert-deftest ladybird-keys-test-special ()
  (should (equal (ladybird-keys-event 'return) '("Return" 10 0)))
  (should (equal (ladybird-keys-event ?\r) '("Return" 10 0)))
  (should (equal (ladybird-keys-event ?\t) '("Tab" 9 0)))
  (should (equal (ladybird-keys-event ?\e) '("Escape" 27 0)))
  (should (equal (ladybird-keys-event 'escape) '("Escape" 27 0)))
  (should (equal (ladybird-keys-event ?\d) '("Backspace" 8 0)))
  (should (equal (ladybird-keys-event ?\M-\d) '("Backspace" 8 4)))
  (should (equal (ladybird-keys-event 'backspace) '("Backspace" 8 0)))
  (should (equal (ladybird-keys-event 'C-backspace) '("Backspace" 8 2)))
  (should (equal (ladybird-keys-event 'delete) '("Delete" 127 0)))
  (should (equal (ladybird-keys-event 'deletechar) '("Delete" 127 0)))
  (should (equal (ladybird-keys-event 'backtab) '("Tab" 9 1)))
  (should (equal (ladybird-keys-event 'S-return) '("Return" 10 1)))
  (should (equal (ladybird-keys-event 'C-M-left) '("Left" 0 6)))
  (should (equal (ladybird-keys-event 'prior) '("PageUp" 0 0)))
  (should (equal (ladybird-keys-event 'next) '("PageDown" 0 0)))
  (should (equal (ladybird-keys-event 'f5) '("F5" 0 0)))
  (should (equal (ladybird-keys-event 's-f12) '("F12" 0 8))))

(ert-deftest ladybird-keys-test-keypad ()
  (should (equal (ladybird-keys-event 'kp-7) '("7" 55 16)))
  (should (equal (ladybird-keys-event 'kp-enter) '("Return" 10 16)))
  (should (equal (ladybird-keys-event 'kp-add) '("Plus" 43 16)))
  (should (equal (ladybird-keys-event 'C-kp-left) '("Left" 0 18))))

(ert-deftest ladybird-keys-test-nothing ()
  (should-not (ladybird-keys-event 'lshift))
  (should-not (ladybird-keys-event 'XF86AudioPlay))
  (should-not (ladybird-keys-event '(mouse-1 (nil 1 (0 . 0) 0)))))

(ert-deftest ladybird-keys-test-modifiers ()
  (should (= (ladybird-keys-modifiers nil) 0))
  (should (= (ladybird-keys-modifiers '(shift control meta super)) 15))
  (should (= (ladybird-keys-modifiers '(alt)) 4))
  (should (= (ladybird-keys-modifiers '(hyper click)) 0)))

(ert-deftest ladybird-keys-test-button ()
  (should (equal (ladybird-keys-button 's-mouse-1) "left"))
  (should (= (ladybird-keys-modifiers (event-modifiers 's-mouse-1)) 8))
  (should (equal (ladybird-keys-button 'down-mouse-2) "middle"))
  (should (equal (ladybird-keys-button '(double-down-mouse-3 (nil 1 (0 . 0) 0) 2))
                 "right"))
  (should (equal (ladybird-keys-button 'mouse-8) "back"))
  (should (equal (ladybird-keys-button 'mouse-9) "forward"))
  (should-not (ladybird-keys-button 'mouse-5)))

(ert-deftest ladybird-keys-test-wheel ()
  (let ((posn '(nil 1 (0 . 0) 0))
        (mouse-wheel-flip-direction nil))
    (should (equal (ladybird-keys-wheel-delta `(wheel-up ,posn 1 1 (0.0 . 24.0)) 16)
                   '(0 . -24)))
    (should (equal (ladybird-keys-wheel-delta `(wheel-down ,posn 1 1 (0.0 . -24.0)) 16)
                   '(0 . 24)))
    (should (equal (ladybird-keys-wheel-delta `(wheel-down ,posn 1 2 nil) 16)
                   '(0 . 32)))
    (should (equal (ladybird-keys-wheel-delta `(wheel-up ,posn) 10) '(0 . -30)))
    (should (equal (ladybird-keys-wheel-delta `(wheel-left ,posn 1 1 nil) 16)
                   '(-16 . 0)))
    (should (equal (ladybird-keys-wheel-delta `(wheel-right ,posn 1 1 nil) 16)
                   '(16 . 0)))
    (should (equal (ladybird-keys-wheel-delta `(mouse-4 ,posn) 16) '(0 . -48)))
    (should (equal (ladybird-keys-wheel-delta `(mouse-7 ,posn) 16) '(48 . 0)))
    (let ((mouse-wheel-flip-direction t))
      (should (equal (ladybird-keys-wheel-delta `(wheel-left ,posn 1 1 nil) 16)
                     '(16 . 0))))))

(ert-deftest ladybird-keys-test-editing ()
  (let ((event (lambda (key) (aref (key-parse key) 0))))
    (dolist (case '(("C-a" (("Home" 0 0)) (("Home" 0 0)))
                    ("C-e" (("End" 0 0)) (("End" 0 0)))
                    ("C-d" (("Delete" 127 0)) (("Delete" 127 0)))
                    ("C-k" (("End" 0 1) ("Delete" 127 0))
                     (("End" 0 1) ("Delete" 127 0)))
                    ("C-f" (("Right" 0 0)) (("Right" 0 0)))
                    ("C-p" (("Up" 0 0)) (("Up" 0 0)))
                    ("M-b" (("Left" 0 2)) (("Left" 0 4)))
                    ("M-f" (("Right" 0 2)) (("Right" 0 4)))
                    ("M-d" (("Delete" 127 2)) (("Delete" 127 4)))
                    ("M-DEL" (("Backspace" 8 2)) (("Backspace" 8 4)))
                    ("M-<backspace>" (("Backspace" 8 2)) (("Backspace" 8 4)))
                    ("C-<backspace>" (("Backspace" 8 2)) (("Backspace" 8 4)))
                    ("C-z" ((edit "undo")) ((edit "undo")))
                    ("C-/" ((edit "undo")) ((edit "undo")))
                    ("C-_" ((edit "undo")) ((edit "undo")))
                    ("C-?" ((edit "redo")) ((edit "redo")))
                    ("C-S-z" ((edit "redo")) ((edit "redo")))))
      (pcase-let ((`(,key ,other ,macos) case))
        (ert-info ((format "key %s" key))
          (should (equal (ladybird-keys-editing (funcall event key) 'linux) other))
          (should (equal (ladybird-keys-editing (funcall event key) nil) other))
          (should (equal (ladybird-keys-editing (funcall event key) 'macos)
                         macos)))))
    ;; A meta key typed as ESC and the key in a terminal.
    (should (equal (ladybird-keys-editing (event-convert-list '(meta ?b)) 'macos)
                   '(("Left" 0 4))))
    (should-not (ladybird-keys-editing ?a 'macos))
    (should-not (ladybird-keys-editing (funcall event "C-x") 'macos))
    (should-not (ladybird-keys-editing 'f5 'linux))
    ;; Every key of the table parses to a single event.
    (dolist (entry ladybird-keys--editing)
      (should (= (length (key-parse (car entry))) 1)))))

(ert-deftest ladybird-keys-test-pointer ()
  (should (eq (ladybird-keys-pointer "pointer") 'hand))
  (should (eq (ladybird-keys-pointer "text") 'text))
  (should (eq (ladybird-keys-pointer "col-resize") 'hdrag))
  (should (eq (ladybird-keys-pointer "zoom-in") 'arrow))
  (should (eq (ladybird-keys-pointer nil) 'arrow)))

(provide 'ladybird-keys-test)

;;; ladybird-keys-test.el ends here
